  @media (min-width: 560px) { .footer-inner { grid-template-columns: 1fr 1fr; } }
  .footer-logo { font-family: var(--ff-head); font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: .5rem; }
  .footer-tagline { font-size: .85rem; line-height: 1.5; margin-bottom: .5rem; color: rgba(255,255,255,.75); }
  .footer-subtitle { font-size: .8rem; opacity: .6; color: rgba(255,255,255,.75); }
  .footer-col h4 { font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: .75rem; }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: .5rem; }
  .footer-col ul li a { font-size: .88rem; color: rgba(255,255,255,.75); transition: color var(--transition); }
  .footer-col ul li a:hover { color: #fff; }
  .footer-bottom {
    margin-top: 2.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255,255,255,.1);
    font-size: .75rem;
    display: flex; flex-direction: column; gap: .35rem;
    text-align: center;
    color: rgba(255,255,255,.4);
  }
  .footer-bottom a { color: #7bc35e; font-weight: 600; }

  /* ── FLOTANTE ── */
  .wa-float {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 200;
    width: 56px; height: 56px;
    background: var(--wa);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(37,211,102,.45);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .wa-float:hover { transform: scale(1.08); box-shadow: 0 6px 20px rgba(37,211,102,.55); }
  .wa-float::before {
    content: '';
    position: absolute; inset: -8px;
    border-radius: 50%;
    background: rgba(37,211,102,.2);
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { transform: scale(1); opacity: .6; }
    50% { transform: scale(1.18); opacity: 0; }
  }
  .wa-float svg { position: relative; z-index: 1; }

  /* ── AVISO VISTA PREVIA ── */
  .aviso-overlay[hidden] { display: none; }
  .aviso-overlay {
    position: fixed; inset: 0;
    z-index: 2000;
    background: rgba(15, 25, 32, 0.55);
    display: flex; align-items: center; justify-content: center;
    padding: 1.25rem;
  }
  .aviso-caja {
    background: #fff;
    border-radius: 14px;
    padding: 1.75rem 1.5rem;
    max-width: 22rem;
    text-align: center;
    animation: badgePop .35s cubic-bezier(.34,1.56,.64,1) both;
  }
  .aviso-caja h3 { font-family: var(--ff-head); font-size: 1.2rem; margin-bottom: .6rem; color: var(--texto); }
  .aviso-caja p { font-size: .92rem; color: var(--texto-suave); margin-bottom: 1.25rem; }
  .aviso-btn {
    display: block;
    background: var(--maguey);
    color: #fff;
    font-weight: 600;
    padding: .75rem 1rem;
    border-radius: 8px;
    margin-bottom: .75rem;
    transition: transform var(--transition);
  }
  .aviso-btn:hover { transform: translateY(-1px); }
  .aviso-cerrar { font-size: .88rem; font-weight: 500; color: var(--texto-suave); }

  /* ── REVEAL ── */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .55s ease, transform .55s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  /* ── Accesibilidad: sin movimiento si el usuario lo pide ── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .reveal, .hero-content.visible > *, .check-grid .check-item, .stats-grid .stat-item { opacity: 1; transform: none; }
  }
</style>
</body>
</html>
