  .servicio-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1.5rem;
    transition: var(--transition);
  }
  .servicio-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .serv-icon { color: var(--primario); margin-bottom: .75rem; }
  .serv-icon svg { transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
  .servicio-card:hover .serv-icon svg { transform: rotate(-6deg) scale(1.15); }
  .serv-name { font-size: 1rem; font-weight: 700; margin-bottom: .35rem; }
  .serv-desc { font-size: .85rem; color: var(--texto-suave); }

  /* ── SOBRE MÍ ── */
  .sobre-section { background: var(--fondo-alt); }
  .sobre-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius-card); overflow: hidden; }
  .sobre-img-placeholder {
    width: 100%; aspect-ratio: 1/1;
