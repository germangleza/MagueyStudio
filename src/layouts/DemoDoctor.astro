  .section-header { margin-bottom: 2rem; }
  .section-header .label { margin-bottom: .75rem; }
  .section-header h2 { margin-bottom: .5rem; }

  /* ── CHECKS + STATS ── */
  .check-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem 1rem; margin: 1.5rem 0 0; text-align: left; }
  .check-item { display: flex; align-items: center; gap: .5rem; font-size: .9rem; font-weight: 500; }
  .check-icon { flex-shrink: 0; width: 20px; height: 20px; background: var(--primario); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; }
  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-top: 1.5rem; }
  .stat-item {
    background: #fff;
    border: 1px solid var(--border);
