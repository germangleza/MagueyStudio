    background-size: 160% 160%;
    animation: gradShift 14s ease-in-out infinite alternate;
    padding-bottom: 3rem; /* despeja el badge de rating */
  }
  @keyframes gradShift { from { background-position: 0% 0%; } to { background-position: 100% 100%; } }
  .hero-img-placeholder span { font-size: .8rem; color: var(--primario); opacity: .75; }
  .avatar {
    width: 84px; height: 84px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #fff;
    color: var(--primario);
    font-family: var(--ff-head);
    font-size: 1.8rem;
    border: 2px solid color-mix(in srgb, var(--primario) 35%, #fff);
