  .check-grid.visible .check-item, .stats-grid.visible .stat-item { animation: fadeUp .5s ease forwards; }
  .check-grid.visible .check-item:nth-child(2), .stats-grid.visible .stat-item:nth-child(2) { animation-delay: .09s; }
  .check-grid.visible .check-item:nth-child(3), .stats-grid.visible .stat-item:nth-child(3) { animation-delay: .18s; }
  .check-grid.visible .check-item:nth-child(4), .stats-grid.visible .stat-item:nth-child(4) { animation-delay: .27s; }

  /* ── SERVICIOS ── */
