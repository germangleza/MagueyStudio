---
// Layout de páginas demo para prospección en frío (/demo/<slug>).
// Autocontenido a propósito: no usa BaseLayout ni global.css para que
// cada demo se vea como el sitio del doctor, no como el de Maguey.
// Todos los datos del doctor vienen de `demo` (src/data/demos/<slug>.json).
// Diseño alineado a la landing /dentista (nav sticky, hero con foto,
// checks + stats, tarjetas, FAQ, footer oscuro, motion).

interface Servicio {
  titulo: string;
  descripcion: string;
}

interface Testimonio {
  texto: string;
  autor: string;
  lugar?: string;
}

interface Faq {
  pregunta: string;
  respuesta: string;
}

interface Stat {
  valor: string;
  etiqueta: string;
}

interface Demo {
  nombre: string;
  especialidad: string;
  ciudad: string;
  colonia?: string;
  telefono: string;
  horario?: string;
  heroDescripcion: string;
  sobreMi: string[];
  tituloSobre?: string;
  tags?: string[];
  destacados?: string[];
  stats?: Stat[];
  servicios: Servicio[];
  testimonios: Testimonio[];
  faq?: Faq[];
  rating?: { valor: string; texto: string };
  branding: {
    primario: string;
    acento: string;
    fondo?: string;
    texto?: string;
  };
}

interface Props {
  demo: Demo;
  slug: string;
}

const { demo, slug } = Astro.props;

// Firma de Maguey en cada demo — fija, no cambia con el branding del doctor.
const MAGUEY_VERDE = '#519536';
const MAGUEY_WA = '5215560663926';
const waMaguey = `https://wa.me/${MAGUEY_WA}?text=${encodeURIComponent(`Hola, vi el demo de ${slug} y me interesa`)}`;

const ubicacion = [demo.colonia, demo.ciudad].filter(Boolean).join(', ');
const iniciales = demo.nombre
  .replace(/^Dra?\.\s*/i, '')
  .split(/\s+/)
  .slice(0, 2)
  .map((p) => p[0])
  .join('');

const colorPrimario = demo.branding.primario;
const colorAcento = demo.branding.acento;
const colorFondo = demo.branding.fondo ?? '#f4f6f8';
const colorTexto = demo.branding.texto ?? '#22303a';

const tituloSobre = demo.tituloSobre ?? 'Conoce a tu especialista';

// Iconos genéricos (trazo) que se ciclan en las tarjetas de servicios.
const iconosServicio = [
  'M12 4.5v15m7.5-7.5h-15', // cruz
  'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z', // escudo
  'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z', // corazón
  'M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z', // llave/precisión
  'M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z', // expediente
  'M13.5 16.875h3.375m0 0h3.375m-3.375 0V13.5m0 3.375v3.375M6 10.5h2.25a2.25 2.25 0 002.25-2.25V6a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 6v2.25A2.25 2.25 0 006 10.5z', // más/plan
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>{demo.nombre} — {demo.especialidad} en {demo.ciudad} · Vista previa</title>
<meta name="description" content={`Vista previa de la página de ${demo.nombre}, ${demo.especialidad} en ${ubicacion}. Demo creado por Maguey Studio.`}>
</head>
<body>

<!-- CINTILLO MAGUEY — firma fija en todos los demos -->
<div class="mg-cintillo" id="mgCintillo">
  <p>Vista previa creada por <strong>Maguey Studio</strong> — así se vería su página</p>
  <a class="mg-cintillo-btn" href={waMaguey} target="_blank" rel="noopener">Me interesa</a>
</div>

<!-- NAV -->
<nav id="demoNav">
  <div class="nav-inner">
    <a href="#inicio" class="nav-logo">{demo.nombre}</a>
    <ul class="nav-links">
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#sobre">Sobre mí</a></li>
      <li><a href="#opiniones">Opiniones</a></li>
      {demo.faq && demo.faq.length > 0 && <li><a href="#faq">FAQ</a></li>}
      <li><a href="#contacto">Contacto</a></li>
    </ul>
    <button class="hamburger" aria-label="Menú" aria-expanded="false" id="menuBtn">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <a href="#servicios" class="mobile-link">Servicios</a>
    <a href="#sobre" class="mobile-link">Sobre mí</a>
    <a href="#opiniones" class="mobile-link">Opiniones</a>
    {demo.faq && demo.faq.length > 0 && <a href="#faq" class="mobile-link">Preguntas frecuentes</a>}
    <a href="#contacto" class="mobile-link">Contacto</a>
  </div>
</nav>

<!-- HERO -->
<section id="inicio" class="hero">
  <div class="container">
    <div class="hero-card reveal">
      <div class="hero-img-placeholder">
        <div class="avatar" aria-hidden="true">{iniciales}</div>
        <span>Aquí iría la foto de {demo.nombre}</span>
      </div>
      {demo.rating && (
        <div class="rating-badge">
          <div class="rating-stars" aria-hidden="true">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <div class="rating-text"><strong>{demo.rating.valor}</strong><br>{demo.rating.texto}</div>
        </div>
      )}
    </div>

    <div class="hero-content reveal">
      <span class="label">{demo.especialidad}</span>
      <h1>{demo.nombre}</h1>
      <p>{demo.heroDescripcion}</p>
      <div class="hero-btns">
        <button class="btn btn-outline" data-aviso>
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Llamar
        </button>
        <button class="btn btn-wa" data-aviso>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </button>
      </div>
    </div>
  </div>
</section>

<!-- CTA + CHECKS + STATS -->
<section id="cita" class="cta-section">
  <div class="container">
    <span class="label reveal">Agenda tu cita</span>
    <h2 class="reveal">Atención cercana, diagnóstico claro</h2>
    <p class="reveal">Consulta en {ubicacion} con seguimiento personalizado.</p>
    <div class="cta-btns reveal">
      <button class="btn btn-wa" data-aviso>Agendar por WhatsApp</button>
      <a href="#servicios" class="btn btn-outline">Ver servicios</a>
    </div>

    {demo.destacados && demo.destacados.length > 0 && (
      <>
        <hr class="divider reveal">
        <div class="check-grid reveal">
          {demo.destacados.map((d) => (
            <div class="check-item">
              <div class="check-icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              {d}
            </div>
          ))}
        </div>
      </>
    )}

    {demo.stats && demo.stats.length > 0 && (
      <>
        <hr class="divider reveal">
        <div class="stats-grid reveal">
          {demo.stats.map((s) => (
            <div class="stat-item">
              <div class="stat-value">{s.valor}</div>
              <div class="stat-label">{s.etiqueta}</div>
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</section>

<!-- SERVICIOS -->
<section id="servicios" class="servicios-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="label">Servicios</span>
      <h2>¿En qué te puedo ayudar?</h2>
    </div>
    <div class="servicios-grid">
      {demo.servicios.map((s, i) => (
        <div class="servicio-card reveal">
          <div class="serv-icon">
            <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"><path stroke-linecap="round" stroke-linejoin="round" d={iconosServicio[i % iconosServicio.length]}/></svg>
          </div>
          <div class="serv-name">{s.titulo}</div>
          <div class="serv-desc">{s.descripcion}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SOBRE MÍ -->
<section id="sobre" class="sobre-section">
  <div class="container">
    <div class="sobre-card reveal">
      <div class="sobre-img-placeholder">
        <div class="avatar avatar-lg" aria-hidden="true">{iniciales}</div>
        <span>Aquí iría la foto de {demo.nombre}</span>
      </div>
      <div class="sobre-body">
        <span class="label">{tituloSobre}</span>
        <h2>{demo.nombre}</h2>
        {demo.sobreMi.map((p) => <p>{p}</p>)}
        {demo.tags && demo.tags.length > 0 && (
          <div class="sobre-tags">
            {demo.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIOS -->
<section id="opiniones" class="testimonios-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="label">Opiniones</span>
      <h2>Lo que dicen mis pacientes</h2>
    </div>
    <div class="testimonios-grid">
      {demo.testimonios.map((t) => (
        <div class="testimonio-card reveal">
          <div class="test-stars" aria-hidden="true">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="test-text">"{t.texto}"</p>
          <div class="test-author">{t.autor}</div>
          {t.lugar && <div class="test-via">{t.lugar}</div>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
{demo.faq && demo.faq.length > 0 && (
  <section id="faq" class="faq-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="label">Preguntas frecuentes</span>
        <h2>Resolvemos tus dudas</h2>
      </div>
      <div class="faq-list">
        {demo.faq.map((f) => (
          <div class="faq-item reveal">
            <button class="faq-q" aria-expanded="false">
              {f.pregunta}
              <svg class="faq-chevron" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-a">{f.respuesta}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CONTACTO -->
<section id="contacto" class="contacto-section">
  <div class="container">
    <span class="label reveal">Contacto</span>
    <h2 class="reveal">¿Hablamos de tu caso?</h2>
    <p class="reveal">Escríbeme y te oriento sobre el siguiente paso.</p>
    <div class="contacto-btns reveal">
      <button class="btn btn-wa" data-aviso>Agendar por WhatsApp</button>
      <button class="btn btn-outline" data-aviso>Llamar ahora</button>
    </div>
    <div class="contacto-info reveal">
      <div class="info-row">
        <div class="info-icon">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div class="info-text"><strong>Consultorio</strong>{ubicacion}</div>
      </div>
      <div class="info-row">
        <div class="info-icon">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <div class="info-text"><strong>Teléfono</strong>{demo.telefono}</div>
      </div>
      {demo.horario && (
        <div class="info-row">
          <div class="info-icon">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="info-text"><strong>Horario</strong>{demo.horario}</div>
        </div>
      )}
    </div>
  </div>
</section>

<!-- MAPA placeholder -->
<section id="ubicacion" class="mapa-section">
  <div class="mapa-placeholder">
    <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6-10l6 3m0 10l5.447-2.724A1 1 0 0021 16.382V5.618a1 1 0 00-1.447-.894L15 7m0 10V7"/></svg>
    <span>Aquí iría el mapa del consultorio · {ubicacion}</span>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="footer-inner">
      <div>
        <div class="footer-logo">{demo.nombre}</div>
        <p class="footer-tagline">{demo.especialidad}</p>
        <p class="footer-subtitle">Consultorio en {ubicacion}</p>
      </div>
      <div class="footer-col">
        <h4>Navegación</h4>
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#sobre">Sobre mí</a></li>
          <li><a href="#opiniones">Opiniones</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>Sitio de demostración creado por <a href={waMaguey} target="_blank" rel="noopener">Maguey Studio</a>.</div>
      <div>Testimonios, opiniones y datos de contacto son ilustrativos.</div>
    </div>
  </div>
</footer>

<!-- Botón flotante (abre el aviso de vista previa) -->
<button class="wa-float" data-aviso aria-label="Agendar por WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</button>

<!-- Aviso al hacer clic en cualquier CTA del demo -->
<div class="aviso-overlay" id="demoAvisoOverlay" role="dialog" aria-modal="true" aria-labelledby="demoAvisoTitulo" hidden>
  <div class="aviso-caja">
    <h3 id="demoAvisoTitulo">Esta es una vista previa</h3>
    <p>Su página real tendría aquí su WhatsApp para que sus pacientes agenden cita directo con usted.</p>
    <a class="aviso-btn" href={waMaguey} target="_blank" rel="noopener">Contactar a Maguey Studio</a>
    <button class="aviso-cerrar" id="demoAvisoCerrar">Cerrar</button>
  </div>
</div>

<script is:inline>
  // Cintillo Maguey: sincronizar altura con el layout (body y nav sticky)
  const cintillo = document.getElementById('mgCintillo');
  const navEl = document.getElementById('demoNav');
  function syncCintillo() {
    const h = cintillo.offsetHeight;
    document.body.style.paddingTop = h + 'px';
    navEl.style.top = h + 'px';
  }
  syncCintillo();
  window.addEventListener('resize', syncCintillo);
  window.addEventListener('load', syncCintillo);

  // Menú móvil
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('mobileMenu');
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    btn.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open);
  });
  document.querySelectorAll('.mobile-link').forEach(l => {
    l.addEventListener('click', () => {
      menu.classList.remove('open');
      btn.classList.remove('open');
      btn.setAttribute('aria-expanded', false);
    });
  });

  // FAQ acordeón
  document.querySelectorAll('.faq-q').forEach(q => {
    q.addEventListener('click', () => {
      const expanded = q.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-q').forEach(x => {
        x.setAttribute('aria-expanded', 'false');
        x.nextElementSibling.classList.remove('open');
      });
      if (!expanded) {
        q.setAttribute('aria-expanded', 'true');
        q.nextElementSibling.classList.add('open');
      }
    });
  });

  // Stagger: tarjetas en cascada
  document.querySelectorAll('.servicios-grid, .testimonios-grid, .faq-list').forEach(grid => {
    [...grid.children].forEach((card, i) => {
      card.style.transitionDelay = (i % 6) * 70 + 'ms';
    });
  });

  // Reveal on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Aviso de vista previa (todos los CTAs del demo)
  const overlay = document.getElementById('demoAvisoOverlay');
  document.querySelectorAll('[data-aviso]').forEach(el => {
    el.addEventListener('click', () => {
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });
  function cerrarAviso() {
    overlay.hidden = true;
    document.body.style.overflow = '';
  }
  document.getElementById('demoAvisoCerrar').addEventListener('click', cerrarAviso);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) cerrarAviso(); });
</script>

<style define:vars={{ colorPrimario, colorAcento, colorFondo, colorTexto, magueyVerde: MAGUEY_VERDE }}>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --primario: var(--colorPrimario);
    --acento: var(--colorAcento);
    --fondo-alt: var(--colorFondo);
    --texto: var(--colorTexto);
    --texto-suave: color-mix(in srgb, var(--texto) 72%, #fff);
    --tint: color-mix(in srgb, var(--primario) 10%, #fff);
    --border: color-mix(in srgb, var(--texto) 13%, #fff);
    --maguey: var(--magueyVerde);
    --wa: #25D366;
    --wa-dark: #1da851;
    --radius-card: 18px;
    --radius-pill: 999px;
    --shadow-md: 0 6px 24px rgba(0,0,0,.10);
    --ff-head: 'Georgia', 'Times New Roman', serif;
    --ff-body: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --transition: .25s ease;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--ff-body); color: var(--texto); background: #fff; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  button { cursor: pointer; font-family: inherit; border: none; background: none; }

  .label {
    display: inline-block;
    font-size: .7rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--primario);
    background: var(--tint);
    padding: .3rem .75rem;
    border-radius: var(--radius-pill);
  }
  h1 { font-family: var(--ff-head); font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.2; color: var(--texto); }
  h2 { font-family: var(--ff-head); font-size: clamp(1.4rem, 4vw, 2rem); line-height: 1.25; color: var(--texto); }
  p { color: var(--texto-suave); }
  .container { width: 100%; max-width: 680px; margin: 0 auto; padding: 0 1.25rem; }
  .divider { border: none; border-top: 1px solid var(--border); margin: 1.75rem 0; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    font-weight: 600; font-size: .92rem;
    padding: .75rem 1.5rem;
    border-radius: var(--radius-pill);
    transition: var(--transition);
    white-space: nowrap;
    will-change: transform;
  }
  .btn:active { transform: scale(.97); }
  .btn-outline { background: transparent; color: var(--texto); border: 2px solid var(--border); }
  .btn-outline:hover { border-color: var(--primario); color: var(--primario); }
  .btn-wa { background: var(--wa); color: #fff; box-shadow: 0 4px 12px rgba(37,211,102,.3); }
  .btn-wa:hover { background: var(--wa-dark); transform: translateY(-1px); }

  /* ── CINTILLO MAGUEY ── */
  .mg-cintillo {
    position: fixed; top: 0; left: 0; right: 0; z-index: 400;
    background: var(--maguey);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    gap: .65rem;
    padding: .5rem 1rem;
    text-align: center;
    animation: mgSlideDown .5s ease both;
  }
  .mg-cintillo p { color: #fff; font-size: .76rem; line-height: 1.35; }
  .mg-cintillo-btn {
    flex-shrink: 0;
    background: #fff;
    color: var(--maguey);
    font-size: .76rem; font-weight: 700;
    padding: .32rem .85rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .mg-cintillo-btn:hover { transform: scale(1.05); box-shadow: 0 3px 10px rgba(0,0,0,.2); }
  @keyframes mgSlideDown { from { transform: translateY(-100%); } to { transform: translateY(0); } }

  /* ── NAV ── */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 60px; padding: 0 1.25rem; max-width: 680px; margin: 0 auto;
  }
  .nav-logo { font-family: var(--ff-head); font-size: 1.1rem; font-weight: 700; color: var(--texto); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nav-links { display: none; list-style: none; gap: 1.5rem; }
  .nav-links a { font-size: .88rem; font-weight: 500; color: var(--texto-suave); transition: color var(--transition); }
  .nav-links a:hover { color: var(--primario); }
  .hamburger { display: flex; flex-direction: column; gap: 5px; padding: .25rem; }
  .hamburger span { display: block; width: 22px; height: 2px; background: var(--texto); border-radius: 2px; transition: var(--transition); }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu { display: none; flex-direction: column; padding: .5rem 1.25rem 1rem; border-top: 1px solid var(--border); }
  .mobile-menu.open { display: flex; }
  .mobile-menu a { padding: .7rem 0; font-size: .95rem; font-weight: 500; color: var(--texto); border-bottom: 1px solid var(--border); }
  .mobile-menu a:last-child { border-bottom: none; }
  @media (min-width: 640px) {
    .nav-links { display: flex; }
    .hamburger { display: none; }
  }

  /* ── HERO ── */
  .hero { padding: 2rem 0 0; }
  .hero-card {
    position: relative;
