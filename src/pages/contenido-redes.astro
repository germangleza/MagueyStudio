---
import BaseLayout from '../layouts/BaseLayout.astro';

const nav = {
  links: [
    { href: '#que-incluye', label: 'Qué incluye' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#faq', label: 'Preguntas' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/', label: 'Inicio' },
  ],
  mobileLinks: [
    { href: '#que-incluye', label: 'Qué incluye' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#faq', label: 'Preguntas' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/', label: 'Inicio' },
  ],
  ctaHref: 'https://wa.me/5215560663926?text=Hola%2C%20quiero%20contenido%20estrat%C3%A9gico%20para%20las%20redes%20de%20mi%20negocio.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F',
  ctaLabel: 'Solicitar Diagnóstico',
  ctaAria: 'Solicitar diagnóstico de contenido y redes por WhatsApp',
};

const footer = {
  links: [
    { href: '/', label: 'Inicio' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/#proceso', label: 'Proceso' },
    { href: 'https://wa.me/5215560663926', label: 'WhatsApp', aria: 'Contactar por WhatsApp' },
  ],
};

const wa = {
  href: 'https://wa.me/5215560663926?text=Hola%2C%20quiero%20contenido%20estrat%C3%A9gico%20para%20las%20redes%20de%20mi%20negocio.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F',
  aria: 'Escríbenos por WhatsApp sobre Contenido y Redes',
};

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Contenido & Redes",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Maguey Studio",
    "url": "https://magueystudio.mx/",
    "telephone": "+525560663926"
  },
  "description": "Contenido estratégico, imágenes y videos producidos con IA para posicionar tu marca en redes sociales y convertir seguidores en clientes.",
  "url": "https://magueystudio.mx/contenido-redes",
  "areaServed": {"@type": "Country", "name": "México"}
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Ya publico en redes y no me trae clientes. ¿Qué están haciendo mal?",
      "acceptedAnswer": {"@type": "Answer", "text": "Publicar por publicar no funciona. La diferencia está en la estrategia: contenido pensado para tu cliente ideal, con mensajes que venden y llamados a la acción claros. Nosotros no llenamos tu feed — construimos un sistema de contenido que empuja a la venta."}
    },
    {
      "@type": "Question",
      "name": "¿El contenido hecho con IA no se ve genérico o falso?",
      "acceptedAnswer": {"@type": "Answer", "text": "Solo cuando se usa sin criterio. Nosotros usamos IA como herramienta de producción — imágenes y videos de nivel profesional en una fracción del tiempo y costo — pero la estrategia, el mensaje y la identidad de tu marca los define un equipo humano que conoce tu negocio."}
    },
    {
      "@type": "Question",
      "name": "¿En qué redes sociales debería estar mi negocio?",
      "acceptedAnswer": {"@type": "Answer", "text": "En las que está tu cliente, no en todas. Para la mayoría de los negocios locales en México eso significa Instagram, Facebook y TikTok — pero lo definimos con datos en el diagnóstico. Mejor dominar dos redes que malvivir en cinco."}
    },
    {
      "@type": "Question",
      "name": "¿Cuántas publicaciones incluye y con qué frecuencia publican?",
      "acceptedAnswer": {"@type": "Answer", "text": "Diseñamos un plan a la medida según tus objetivos y tu presupuesto: desde un plan base con publicaciones semanales estratégicas hasta producción intensiva con video. La constancia importa más que el volumen — y de eso nos encargamos nosotros."}
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tarda en verse resultado en redes?",
      "acceptedAnswer": {"@type": "Answer", "text": "El contenido es un activo que se acumula. Las primeras semanas construyen presencia y confianza; entre el segundo y tercer mes normalmente se ve tracción clara: más alcance, más mensajes y más clientes que llegan diciendo 'los vi en redes'."}
    },
    {
      "@type": "Question",
      "name": "¿Ustedes responden los mensajes y comentarios que genera el contenido?",
      "acceptedAnswer": {"@type": "Answer", "text": "Podemos ir más allá: combinamos el contenido con nuestros agentes de IA para que cada mensaje que genere una publicación se responda al instante, 24/7, y ningún interesado se quede sin atención. Contenido que atrae + automatización que atiende = clientes."}
    }
  ]
};
---
<BaseLayout
  title="Contenido & Redes Sociales que Venden | Maguey Studio®"
  description="Contenido estratégico, imágenes y videos con IA para posicionar tu marca y convertir seguidores en clientes. Estrategia, producción y medición. Solicita tu diagnóstico gratuito."
  canonical="https://magueystudio.mx/contenido-redes"
  image="https://magueystudio.mx/logo.png"
  ogType="website"
  ogTitle="Contenido & Redes Sociales que Venden | Maguey Studio®"
  ogDescription="Contenido estratégico, imágenes y videos con IA para posicionar tu marca y convertir seguidores en clientes."
  twitterTitle="Contenido & Redes Sociales que Venden | Maguey Studio®"
  twitterDescription="Contenido estratégico, imágenes y videos con IA para posicionar tu marca y convertir seguidores en clientes."
  nav={nav}
  footer={footer}
  wa={wa}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />

<main id="main-content">

<!-- HERO -->
<section class="hero" aria-label="Contenido y redes sociales que convierten seguidores en clientes">
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>

  <div class="hero-tag" style="position:relative;z-index:1;">Contenido &amp; Redes</div>

  <h1 class="hero-title" style="position:relative;z-index:1;">
    CONTENIDO QUE CONVIERTE<br>
    <em class="glitch" data-text="SEGUIDORES">SEGUIDORES</em><br>
    <span class="outline">EN CLIENTES</span>
  </h1>

  <div class="hero-content" style="position:relative;z-index:1;">
    <div class="hero-bottom">
      <p class="hero-desc">
        Contenido estratégico, imágenes y videos producidos con IA para posicionar tu marca donde está tu cliente — y hacer que cada publicación trabaje para vender, no solo para verse bien.
      </p>
      <div class="hero-actions">
        <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20contenido%20estrat%C3%A9gico%20para%20las%20redes%20de%20mi%20negocio.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
        <a href="#que-incluye" class="btn-ghost">Ver qué incluye</a>
      </div>
    </div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-inner">
    <span class="ticker-item">Estrategia de Contenido</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Imágenes con IA</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Video</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Posicionamiento de Marca</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Redes Sociales</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Seguidores → Clientes</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Estrategia de Contenido</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Imágenes con IA</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Video</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Posicionamiento de Marca</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Redes Sociales</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Seguidores → Clientes</span><span class="ticker-sep">✦</span>
  </div>
</div>

<!-- PROBLEMA -->
<section class="problem-section" aria-label="El problema con la mayoría del contenido en redes">
  <div class="section-label reveal" style="justify-content:center;">El problema</div>
  <h2 class="problem-title reveal">
    CASI TODOS LOS NEGOCIOS PUBLICAN EN REDES.<br>
    <em style="font-style:normal; color:var(--green);">CASI NINGUNO VENDE CON ELLAS.</em>
  </h2>
  <p class="problem-desc reveal">
    Publicar sin estrategia es gritar al vacío. Si tu contenido no está pensado para atraer, generar confianza y empujar a la acción, solo estás alimentando el algoritmo — no tu negocio.
  </p>
</section>

<!-- QUÉ INCLUYE -->
<section id="que-incluye" aria-label="Qué incluye el servicio de contenido y redes de Maguey Studio">
  <div class="section-label reveal">Lo que construimos</div>
  <h2 class="features-title reveal">TU MARCA CON<br>PRESENCIA QUE <em>VENDE</em></h2>

  <div class="features-grid">
    <div class="feature-card reveal">
      <span class="feature-icon">◈</span>
      <h3 class="feature-name">Estrategia de Contenido</h3>
      <p class="feature-desc">Nada de publicar por publicar. Un plan editorial con objetivos claros: atraer a tu cliente ideal, generar confianza y provocar la compra.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">◉</span>
      <h3 class="feature-name">Imágenes con IA</h3>
      <p class="feature-desc">Visuales de nivel profesional producidos con IA: consistentes con tu marca, imposibles de ignorar y a una fracción del costo de una producción tradicional.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⚡</span>
      <h3 class="feature-name">Video que Detiene el Scroll</h3>
      <p class="feature-desc">Reels y videos cortos diseñados para captar atención en los primeros 2 segundos y llevar al espectador a la acción.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⟡</span>
      <h3 class="feature-name">Copy que Vende</h3>
      <p class="feature-desc">Textos con la voz de tu marca y un objetivo comercial: cada pie de foto, cada guion y cada llamado a la acción empujan hacia la venta.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⬡</span>
      <h3 class="feature-name">Medición de Resultados</h3>
      <p class="feature-desc">Reportes claros de lo que importa: alcance, interacción y — sobre todo — mensajes y clientes generados. Duplicamos lo que funciona.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">✦</span>
      <h3 class="feature-name">Amplificado con GEO</h3>
      <p class="feature-desc">Tu contenido se apoya en <a href="/geo">GEO</a>: construimos tu presencia para que ChatGPT, Gemini y otros motores de IA también recomienden tu marca.</p>
    </div>
  </div>

  <div class="section-cta reveal">
    <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20contenido%20estrat%C3%A9gico%20para%20las%20redes%20de%20mi%20negocio.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
  </div>
</section>

<!-- PROCESO -->
<section class="process" id="proceso" aria-label="Proceso de contenido y redes sociales">
  <div class="process-grid-bg"></div>
  <div style="position:relative;">
    <div class="section-label reveal">Proceso</div>
    <h2 class="process-title reveal">ASÍ CONSTRUIMOS<br>TU <em>PRESENCIA</em></h2>

    <div class="steps">
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">01</div>
        <h3 class="step-title">Diagnóstico</h3>
        <p class="step-desc">Analizamos tu marca, tu audiencia y qué está haciendo tu competencia en redes.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">02</div>
        <h3 class="step-title">Estrategia & Identidad</h3>
        <p class="step-desc">Definimos voz, pilares de contenido y el plan editorial que conecta con tu cliente ideal.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">03</div>
        <h3 class="step-title">Producción con IA</h3>
        <p class="step-desc">Creamos imágenes, videos y copys con calidad profesional y velocidad que el mercado no puede igualar.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">04</div>
        <h3 class="step-title">Publicación & Optimización</h3>
        <p class="step-desc">Publicamos con constancia, medimos cada pieza y duplicamos lo que genera clientes.</p>
      </div>
    </div>

    <div class="section-cta reveal">
      <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20contenido%20estrat%C3%A9gico%20para%20las%20redes%20de%20mi%20negocio.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
    </div>
  </div>
</section>

<!-- PARA QUIÉN -->
<section id="para-quien" aria-label="Para qué tipo de negocio es ideal el servicio de contenido y redes">
  <div class="section-label reveal">Ideal para</div>
  <h2 class="forwho-title reveal">¿ES PARA<br>TU <em>NEGOCIO</em>?</h2>

  <div class="forwho-grid">
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Marcas que quieren verse profesionales sin producciones carísimas</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Restaurantes, cafés y negocios con producto visual</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Clínicas, spas y servicios que venden confianza</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Negocios con seguidores que no se convierten en ventas</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Dueños sin tiempo para pensar qué publicar cada día</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Empresas que quieren una marca reconocida en su ciudad</span>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="faq-section" id="faq" aria-label="Preguntas frecuentes sobre contenido y redes sociales">
  <div class="section-label reveal">Preguntas frecuentes</div>
  <h2 class="faq-title reveal">LO QUE TODOS<br>NOS <em>PREGUNTAN</em></h2>

  <div class="faq-list">
    <details class="faq-item reveal">
      <summary>Ya publico en redes y no me trae clientes. ¿Qué están haciendo mal?</summary>
      <p class="faq-answer">Publicar por publicar no funciona. La diferencia está en la estrategia: contenido pensado para tu cliente ideal, con mensajes que venden y llamados a la acción claros. Nosotros no llenamos tu feed — construimos un sistema de contenido que empuja a la venta.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿El contenido hecho con IA no se ve genérico o falso?</summary>
      <p class="faq-answer">Solo cuando se usa sin criterio. Nosotros usamos IA como herramienta de producción — imágenes y videos de nivel profesional en una fracción del tiempo y costo — pero la estrategia, el mensaje y la identidad de tu marca los define un equipo humano que conoce tu negocio.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿En qué redes sociales debería estar mi negocio?</summary>
      <p class="faq-answer">En las que está tu cliente, no en todas. Para la mayoría de los negocios locales en México eso significa Instagram, Facebook y TikTok — pero lo definimos con datos en el diagnóstico. Mejor dominar dos redes que malvivir en cinco.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Cuántas publicaciones incluye y con qué frecuencia publican?</summary>
      <p class="faq-answer">Diseñamos un plan a la medida según tus objetivos y tu presupuesto: desde un plan base con publicaciones semanales estratégicas hasta producción intensiva con video. La constancia importa más que el volumen — y de eso nos encargamos nosotros.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Cuánto tiempo tarda en verse resultado en redes?</summary>
      <p class="faq-answer">El contenido es un activo que se acumula. Las primeras semanas construyen presencia y confianza; entre el segundo y tercer mes normalmente se ve tracción clara: más alcance, más mensajes y más clientes que llegan diciendo "los vi en redes".</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Ustedes responden los mensajes y comentarios que genera el contenido?</summary>
      <p class="faq-answer">Podemos ir más allá: combinamos el contenido con nuestros <a href="/automatizacion-ia" style="color:var(--green);">agentes de IA</a> para que cada mensaje que genere una publicación se responda al instante, 24/7, y ningún interesado se quede sin atención. Contenido que atrae + automatización que atiende = clientes.</p>
    </details>
  </div>
</section>

<!-- CTA FINAL -->
<section class="cta-section" aria-label="Solicitar diagnóstico gratuito de contenido y redes">
  <div class="cta-grid-bg"></div>
  <div class="cta-eyebrow reveal">Sin compromiso. Sin costo.</div>
  <h2 class="cta-title reveal">TU MARCA<br><span class="glitch-word" data-text="IMPOSIBLE">IMPOSIBLE</span><br>DE IGNORAR</h2>
  <div style="position:relative;z-index:1;">
    <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20contenido%20estrat%C3%A9gico%20para%20las%20redes%20de%20mi%20negocio.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
    <p class="cta-sub">Auditamos tus redes y te decimos exactamente qué contenido necesita tu negocio.</p>
  </div>
</section>

</main>

<style is:global>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 140px 5% 80px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,255,65,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,65,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridshift 20s linear infinite;
  }
  @keyframes gridshift {
    0% { transform: translate(0,0); }
    100% { transform: translate(60px,60px); }
  }
  .hero-glow {
    position: absolute;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(0,255,65,0.08) 0%, transparent 70%);
    top: 10%; right: -100px;
    border-radius: 50%;
    animation: pulse 4s ease-in-out infinite alternate;
  }
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.2); opacity: 1; }
  }
  .hero-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--green);
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    animation: fadeUp 1s ease both;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(64px, 8vw, 120px);
    line-height: 0.92;
    letter-spacing: -1px;
    margin-bottom: 0;
    max-width: 80%;
    animation: slideFromLeft 1s 0.1s ease both;
  }
  @keyframes slideFromLeft {
    from { opacity: 0; transform: translateX(-60px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .hero-title em { font-style: normal; color: var(--green); }
  .hero-title .outline {
    -webkit-text-stroke: 1px var(--white);
    color: transparent;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    width: 100%;
    animation: fadeUp 1s 0.15s ease both;
    margin-top: 48px;
  }
  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    max-width: 540px;
  }
  .hero-desc {
    font-size: 18px;
    line-height: 1.7;
    color: var(--white);
    font-weight: 300;
    text-align: center;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* TICKER */
  .ticker {
    background: var(--green);
    padding: 14px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .ticker-inner { display: inline-flex; animation: ticker 20s linear infinite; }
  .ticker-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--black);
    padding: 0 40px;
  }
  .ticker-sep { font-size: 18px; color: rgba(0,0,0,0.3); padding: 0 10px; }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* PROBLEM SECTION */
  .problem-section {
    background: var(--dark);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .problem-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    margin-bottom: 32px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  .problem-desc {
    font-size: 18px;
    line-height: 1.8;
    color: var(--white);
    font-weight: 300;
    max-width: 560px;
    margin: 0 auto;
  }

  /* FEATURES GRID */
  .features-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 0.95;
    margin-bottom: 80px;
    max-width: 700px;
  }
  .features-title em { font-style: normal; color: var(--green); }

  .features-grid {
    display: grid;
