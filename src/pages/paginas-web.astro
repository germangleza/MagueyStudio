---
import BaseLayout from '../layouts/BaseLayout.astro';

const nav = {
  links: [
    { href: '#que-incluye', label: 'Qué incluye' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#para-quien', label: 'Para quién' },
    { href: '/', label: 'Inicio' },
  ],
  mobileLinks: [
    { href: '#que-incluye', label: 'Qué incluye' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#para-quien', label: 'Para quién' },
    { href: '/', label: 'Inicio' },
  ],
  ctaHref: 'https://wa.me/5215560663926',
  ctaLabel: 'Solicitar Diagnóstico',
  ctaAria: 'Solicitar diagnóstico por WhatsApp',
};

const footer = {
  links: [
    { href: '/', label: 'Inicio' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/#proceso', label: 'Proceso' },
    { href: 'https://wa.me/5215560663926', label: 'WhatsApp', aria: 'Contactar por WhatsApp' },
  ],
};

const wa = {};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Páginas Web",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Maguey Studio",
    "url": "https://magueystudio.mx/",
    "telephone": "+525560663926"
  },
  "description": "Diseño y desarrollo de páginas web de alto rendimiento orientadas a conversión, con SEO técnico y optimización para motores de IA (GEO).",
  "url": "https://magueystudio.mx/paginas-web",
  "areaServed": {"@type": "Country", "name": "México"}
};
---
<BaseLayout
  title="Páginas Web que Convierten | Maguey Studio®"
  description="Diseño y desarrollo de páginas web profesionales que convierten visitas en clientes. Rápidas, optimizadas para Google y recomendadas por ChatGPT. Solicita tu diagnóstico gratuito."
  canonical="https://magueystudio.mx/paginas-web"
  ogType="website"
  ogTitle="Páginas Web que Convierten | Maguey Studio®"
  ogDescription="Páginas web diseñadas para convertir visitas en clientes. Rápidas, con SEO y optimizadas para IA."
  twitterTitle="Páginas Web que Convierten | Maguey Studio®"
  twitterDescription="Páginas web diseñadas para convertir visitas en clientes. Rápidas, con SEO y optimizadas para IA."
  isHome={false}
  nav={nav}
  footer={footer}
  wa={wa}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />

<main id="main-content">

<!-- HERO -->
<section class="hero" aria-label="Páginas web que convierten visitas en clientes">
  <canvas id="matrixCanvas" style="position:absolute;inset:0;width:100%;height:100%;opacity:0.18;pointer-events:none;z-index:0;"></canvas>
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>

  <div class="hero-tag" style="position:relative;z-index:1;">Páginas Web</div>

  <h1 class="hero-title" style="position:relative;z-index:1;">
    PÁGINAS WEB QUE<br>
    <em class="glitch" data-text="CONVIERTEN">CONVIERTEN</em><br>
    <span class="outline">VISITAS EN CLIENTES</span>
  </h1>

  <div class="hero-content" style="position:relative;z-index:1;">
    <div class="hero-bottom">
      <p class="hero-desc">
        Tu sitio web debería ser tu mejor vendedor. Diseñamos páginas rápidas, profesionales y optimizadas para que cada visitante se convierta en una oportunidad de negocio.
      </p>
      <div class="hero-actions">
        <a href="https://wa.me/5215560663926" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
        <a href="#que-incluye" class="btn-ghost">Ver qué incluye</a>
      </div>
    </div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker">
  <div class="ticker-inner">
    <span class="ticker-item">Diseño Web</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">SEO Técnico</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Optimizado para IA</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Carga Rápida</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Responsive</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Orientado a Conversión</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Diseño Web</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">SEO Técnico</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Optimizado para IA</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Carga Rápida</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Responsive</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Orientado a Conversión</span><span class="ticker-sep">✦</span>
  </div>
</div>

<!-- PROBLEMA -->
<section class="problem-section" aria-label="El problema con la mayoría de páginas web">
  <div class="section-label reveal" style="justify-content:center;">El problema</div>
  <h2 class="problem-title reveal">
    LA MAYORÍA DE LOS NEGOCIOS TIENE UNA PÁGINA WEB.<br>
    <em style="font-style:normal; color:var(--green);">POCOS TIENEN UNA QUE VENDE.</em>
  </h2>
  <p class="problem-desc reveal">
    Un sitio lento, sin estructura clara o que no aparece en Google no es un activo — es un costo. Cada visita que no convierte es dinero que se va.
  </p>
</section>

<!-- QUÉ INCLUYE -->
<section id="que-incluye" aria-label="Qué incluye una página web de Maguey Studio">
  <div class="section-label reveal">Lo que construimos</div>
  <h2 class="features-title reveal">TODO LO QUE<br>TU SITIO <em>NECESITA</em></h2>

  <div class="features-grid">
    <div class="feature-card reveal">
      <span class="feature-icon">◈</span>
      <h3 class="feature-name">Diseño Orientado a Conversión</h3>
      <p class="feature-desc">Cada sección está diseñada con un propósito: guiar al visitante hacia la acción que tú quieres.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⚡</span>
      <h3 class="feature-name">Velocidad &lt; 2 Segundos</h3>
      <p class="feature-desc">Los sitios lentos pierden clientes. Los nuestros cargan rápido en cualquier dispositivo y conexión.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⬡</span>
      <h3 class="feature-name">SEO Técnico Incluido</h3>
      <p class="feature-desc">Estructura, meta tags, Schema.org y todo lo necesario para que Google te encuentre y te posicione.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">◉</span>
      <h3 class="feature-name">Optimizado para IA (GEO)</h3>
      <p class="feature-desc">Preparamos tu sitio para que ChatGPT, Gemini y otros motores de IA te recomienden cuando alguien pregunte por tu negocio. <a href="/geo" style="color:var(--green);">Conoce nuestro servicio de GEO →</a></p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⟡</span>
      <h3 class="feature-name">100% Responsive</h3>
      <p class="feature-desc">Se ve y funciona perfecto en celular, tablet y computadora. Sin compromisos en ningún dispositivo.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">✦</span>
      <h3 class="feature-name">Integración con WhatsApp</h3>
      <p class="feature-desc">Botones de contacto directo para que el cliente llegue a ti sin fricción, sin formularios complicados.</p>
    </div>
  </div>

  <div class="section-cta reveal">
    <a href="https://wa.me/5215560663926" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
  </div>
</section>

<!-- PROCESO -->
<section class="process" id="proceso" aria-label="Proceso de desarrollo de páginas web">
  <div class="process-grid-bg"></div>
  <div style="position:relative;">
    <div class="section-label reveal">Proceso</div>
    <h2 class="process-title reveal">ASÍ CONSTRUIMOS<br>TU <em>SITIO WEB</em></h2>

    <div class="steps">
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">01</div>
        <h3 class="step-title">Diagnóstico</h3>
        <p class="step-desc">Analizamos tu negocio, tu competencia y lo que necesitas comunicar para atraer clientes.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">02</div>
        <h3 class="step-title">Estrategia & Copy</h3>
        <p class="step-desc">Definimos la estructura, el mensaje y el recorrido del visitante de principio a fin.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">03</div>
        <h3 class="step-title">Diseño & Código</h3>
        <p class="step-desc">Construimos tu sitio desde cero con tecnología de alto rendimiento. Sin plantillas genéricas.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">04</div>
        <h3 class="step-title">Lanzamiento & Seguimiento</h3>
        <p class="step-desc">Publicamos, medimos y ajustamos. Tu proyecto no termina en la entrega — empieza ahí.</p>
      </div>
    </div>

    <div class="section-cta reveal">
      <a href="https://wa.me/5215560663926" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
    </div>
  </div>
</section>

<!-- PARA QUIÉN -->
<section class="forwho-section" id="para-quien" aria-label="Para qué tipo de negocio es ideal">
  <div class="section-label reveal">Ideal para</div>
  <h2 class="forwho-title reveal">¿ES PARA<br>TU <em>NEGOCIO</em>?</h2>

  <div class="forwho-grid">
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Restaurantes, cafés y negocios de alimentos</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Clínicas, consultorios y servicios de salud</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Spas, salones de belleza y estética</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Despachos legales y contables</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Hoteles y servicios turísticos</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Tiendas y comercios locales</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Servicios profesionales y consultorías</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Cualquier negocio que quiera atraer clientes en línea</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Empresas que quieren ser recomendadas por IA</span>
    </div>
  </div>
</section>

<!-- POR QUÉ MAGUEY -->
<section aria-label="Por qué elegir Maguey Studio para tu página web">
  <div class="section-label reveal">Por qué nosotros</div>
  <h2 class="features-title reveal">NO SOMOS UNA<br>AGENCIA DE <em>PLANTILLAS</em></h2>

  <div class="why-grid">
    <div class="why-item reveal">
      <div class="why-item-border"><span></span><span></span><span></span><span></span></div>
      <div class="why-content">
        <h3>Construido desde cero</h3>
        <p>Cada proyecto es desarrollado a medida para tu negocio. Sin themes genéricos. Sin diseños que parecen de otra empresa.</p>
      </div>
    </div>
    <div class="why-item reveal">
      <div class="why-item-border"><span></span><span></span><span></span><span></span></div>
      <div class="why-content">
        <h3>Orientados a resultados</h3>
        <p>No diseñamos para que se vea bonito. Diseñamos para que convierta — cada elemento tiene un objetivo claro.</p>
      </div>
    </div>
    <div class="why-item reveal">
      <div class="why-item-border"><span></span><span></span><span></span><span></span></div>
      <div class="why-content">
        <h3>Preparados para el futuro</h3>
        <p>SEO técnico y <a href="/geo" style="color:var(--green);">GEO</a> incluidos para que aparezcas tanto en Google como en las recomendaciones de ChatGPT y Gemini.</p>
      </div>
    </div>
    <div class="why-item reveal">
      <div class="why-item-border"><span></span><span></span><span></span><span></span></div>
      <div class="why-content">
        <h3>Acompañamiento continuo</h3>
        <p>Estamos contigo después del lanzamiento. Medimos, optimizamos y seguimos mejorando tu sitio mes a mes.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA FINAL -->
<section class="cta-section" aria-label="Solicitar diagnóstico gratuito">
  <div class="cta-grid-bg"></div>
  <div class="cta-eyebrow reveal">Sin compromiso. Sin costo.</div>
  <h2 class="cta-title reveal">TU PÁGINA WEB<br><span class="glitch-word" data-text="LISTA">LISTA</span><br>PARA VENDER</h2>
  <div style="position:relative;z-index:1;">
    <a href="https://wa.me/5215560663926" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
    <p class="cta-sub">Analizamos tu negocio y te decimos exactamente qué necesitas.</p>
  </div>
</section>

</main>

<style is:global>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 140px 5% 80px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,255,65,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,65,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridshift 20s linear infinite;
  }
  @keyframes gridshift {
    0% { transform: translate(0,0); }
    100% { transform: translate(60px,60px); }
  }
  .hero-glow {
    position: absolute;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(0,255,65,0.08) 0%, transparent 70%);
    top: 10%; right: -100px;
    border-radius: 50%;
    animation: pulse 4s ease-in-out infinite alternate;
  }
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.2); opacity: 1; }
  }
  .hero-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--green);
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    animation: fadeUp 1s ease both;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(64px, 8vw, 120px);
    line-height: 0.92;
    letter-spacing: -1px;
    margin-bottom: 0;
    max-width: 80%;
    animation: slideFromLeft 1s 0.1s ease both;
  }
  @keyframes slideFromLeft {
    from { opacity: 0; transform: translateX(-60px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .hero-title em { font-style: normal; color: var(--green); }
  .hero-title .outline {
    -webkit-text-stroke: 1px var(--white);
    color: transparent;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    width: 100%;
    animation: fadeUp 1s 0.15s ease both;
    margin-top: 48px;
  }
  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    max-width: 540px;
  }
  .hero-desc {
    font-size: 18px;
    line-height: 1.7;
    color: var(--white);
    font-weight: 300;
    text-align: center;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* TICKER */
  .ticker {
    background: var(--green);
    padding: 14px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .ticker-inner { display: inline-flex; animation: ticker 20s linear infinite; }
  .ticker-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--black);
    padding: 0 40px;
  }
  .ticker-sep { font-size: 18px; color: rgba(0,0,0,0.3); padding: 0 10px; }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* PROBLEM SECTION */
  .problem-section {
    background: var(--dark);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .problem-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    margin-bottom: 32px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  .problem-desc {
    font-size: 18px;
    line-height: 1.8;
    color: var(--white);
    font-weight: 300;
    max-width: 560px;
    margin: 0 auto;
  }

  /* FEATURES GRID */
  .features-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 0.95;
    margin-bottom: 80px;
    max-width: 700px;
  }
  .features-title em { font-style: normal; color: var(--green); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .feature-card {
    background: var(--dark);
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
  }
  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,255,65,0.04) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .feature-card:hover { background: var(--dark); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon {
    font-size: 32px;
    margin-bottom: 24px;
    display: block;
  }
  .feature-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    margin-bottom: 12px;
    line-height: 1;
    color: var(--white);
  }
  .feature-desc {
    font-size: 16px;
    line-height: 1.8;
    color: var(--white);
    font-weight: 300;
  }

  /* PROCESS */
  .process {
    background: var(--dark);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }
  .process-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,255,65,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,65,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridshift 20s linear infinite;
    pointer-events: none;
  }
  .process-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.95;
    margin-bottom: 80px;
    max-width: 700px;
  }
  .process-title em { font-style: normal; color: var(--green); }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    position: relative;
  }
  .steps::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--green) 30%, rgba(0,255,65,0.6) 60%, transparent 100%);
    background-size: 200% 100%;
    animation: scanLine 3s linear infinite;
  }
  @keyframes scanLine {
    0% { background-position: -100% 0; }
    100% { background-position: 200% 0; }
  }
  .step { padding-top: 60px; position: relative; }
  .step-dot {
    position: absolute;
    top: 20px; left: 0;
    width: 16px; height: 16px;
    background: var(--green);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  .step-num {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--green);
    margin-bottom: 16px;
    opacity: 0.6;
  }
  .step-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }
  .step-desc {
    font-size: 17px;
    line-height: 1.8;
    color: var(--white);
    font-weight: 300;
  }

  /* FOR WHO */
  .forwho-section { }
  .forwho-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 0.95;
    margin-bottom: 64px;
    max-width: 700px;
  }
  .forwho-title em { font-style: normal; color: var(--green); }
  .forwho-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 80px;
  }
  .forwho-item {
    background: var(--dark);
    padding: 32px 36px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: background 0.2s;
  }
  .forwho-item:hover { background: var(--dark); }
  .forwho-dot {
    width: 8px; height: 8px;
    background: var(--green);
    flex-shrink: 0;
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  .forwho-item span {
    font-size: 17px;
    font-weight: 300;
    color: var(--white);
  }

  /* WHY */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 80px;
  }
  .why-item {
    background: var(--dark);
    padding: 48px 40px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .why-item-border {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .why-item-border span { position: absolute; display: block; }
  .why-item-border span:nth-child(1) {
    top: 0; left: -100%;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, var(--green));
    animation: borderTop 4.5s linear infinite;
  }
  .why-item-border span:nth-child(2) {
    top: -100%; right: 0;
    width: 2px; height: 100%;
    background: linear-gradient(180deg, transparent, var(--green));
    animation: borderRight 4.5s linear infinite 1.125s;
  }
  .why-item-border span:nth-child(3) {
    bottom: 0; right: -100%;
    width: 100%; height: 2px;
    background: linear-gradient(270deg, transparent, var(--green));
    animation: borderBottom 4.5s linear infinite 2.25s;
  }
  .why-item-border span:nth-child(4) {
    bottom: -100%; left: 0;
    width: 2px; height: 100%;
    background: linear-gradient(360deg, transparent, var(--green));
    animation: borderLeft 4.5s linear infinite 3.375s;
  }
  @keyframes borderTop    { 0%{left:-100%} 100%{left:100%} }
  @keyframes borderRight  { 0%{top:-100%}  100%{top:100%}  }
  @keyframes borderBottom { 0%{right:-100%}100%{right:100%}}
  @keyframes borderLeft   { 0%{bottom:-100%}100%{bottom:100%}}
  .why-content h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .why-content p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--white);
    font-weight: 300;
  }

  /* CTA */
  .cta-section {
    text-align: center;
    padding: 160px 5%;
    position: relative;
    overflow: hidden;
  }
  .cta-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,255,65,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,65,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridshift 20s linear infinite;
    pointer-events: none;
  }
  .cta-section::before {
    content: 'MAGUEY';
    position: absolute;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 38vw;
    color: rgba(0,255,65,0.08);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
    letter-spacing: -5px;
  }
  .cta-eyebrow {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 24px;
  }
  .cta-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(56px, 9vw, 130px);
    line-height: 0.9;
    margin-bottom: 48px;
  }
  .cta-title .glitch-word {
    font-style: normal;
    color: var(--green);
    position: relative;
    display: inline-block;
    animation: ctaGlitch 2.5s infinite;
  }
  .cta-title .glitch-word::before,
  .cta-title .glitch-word::after {
    content: attr(data-text);
    position: absolute;
    left: 0; top: 0;
    width: 100%;
  }
  .cta-title .glitch-word::before {
    color: #ff00c8;
    animation: ctaGlitchTop 2.5s infinite;
    clip-path: polygon(0 0, 100% 0, 100% 40%, 0 40%);
  }
  .cta-title .glitch-word::after {
    color: #00eeff;
    animation: ctaGlitchBot 2.5s infinite;
    clip-path: polygon(0 60%, 100% 60%, 100% 100%, 0 100%);
  }
  @keyframes ctaGlitch {
    0%, 90%, 100% { transform: none; }
    91% { transform: skewX(-2deg); }
    93% { transform: skewX(2deg); }
    95% { transform: skewX(0deg); }
  }
  @keyframes ctaGlitchTop {
    0%, 90%, 100% { transform: none; opacity: 0; }
    91% { transform: translate(-3px, -2px); opacity: 1; }
    93% { transform: translate(3px, 0px); opacity: 1; }
    95% { transform: none; opacity: 0; }
  }
  @keyframes ctaGlitchBot {
    0%, 90%, 100% { transform: none; opacity: 0; }
    91% { transform: translate(3px, 2px); opacity: 1; }
    93% { transform: translate(-3px, 0px); opacity: 1; }
    95% { transform: none; opacity: 0; }
  }
  .cta-sub {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-top: 24px;
    text-transform: uppercase;
  }

  .section-cta {
    margin-top: 64px;
    text-align: center;
  }

  /* GLITCH */
  .glitch { position: relative; }
  .glitch::before, .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: inherit;
    pointer-events: none;
  }
  .glitch::before {
    color: var(--green);
    animation: glitchTop 2s infinite linear;
    clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
  }
  .glitch::after {
    color: #fff;
    animation: glitchBot 2s infinite linear;
    clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
  }
  @keyframes glitchTop {
    0%, 75%, 100% { transform: translate(0); opacity: 0; }
    76% { transform: translate(-3px, -2px); opacity: 0.8; }
    79% { transform: translate(3px, 1px); opacity: 0.8; }
    82% { transform: translate(-2px, 2px); opacity: 0.8; }
    85% { transform: translate(2px, -1px); opacity: 0.8; }
    88% { transform: translate(0); opacity: 0; }
  }
  @keyframes glitchBot {
    0%, 75%, 100% { transform: translate(0); opacity: 0; }
    77% { transform: translate(3px, 2px); opacity: 0.6; }
    80% { transform: translate(-3px, -1px); opacity: 0.6; }
    83% { transform: translate(2px, 1px); opacity: 0.6; }
    86% { transform: translate(-1px, 0); opacity: 0.6; }
    88% { transform: translate(0); opacity: 0; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* MOBILE */
  @media (max-width: 900px) {
    .hero { align-items: center; text-align: center; }
    .hero-title { font-size: clamp(52px, 13vw, 90px); max-width: 100%; }
    .hero-content { flex-direction: column; align-items: center; margin-top: 32px; }
    .hero-bottom { align-items: center; max-width: 100%; }
    .hero-desc { font-size: 16px; text-align: center; }
    .hero-actions { align-items: center; }
    .features-grid { grid-template-columns: 1fr; }
    .forwho-grid { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .step:nth-child(3)::before {
      content: '';
      position: absolute;
      top: 28px; left: 0;
      width: calc(200% + 40px); height: 1px;
      background: linear-gradient(90deg, transparent 0%, var(--green) 30%, rgba(0,255,65,0.6) 60%, transparent 100%);
      background-size: 200% 100%;
      animation: scanLine 3s linear infinite;
    }
    .why-grid { grid-template-columns: 1fr; gap: 16px; }
    .why-item { min-height: 180px; }
  }
</style>

<script is:inline>
  // MATRIX RAIN
  (function() {
    const canvas = document.getElementById('matrixCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ01アBCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
    let cols, drops;

    function init() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      cols  = Math.floor(canvas.width / 16);
      drops = Array(cols).fill(1);
    }

    function draw() {
      ctx.fillStyle = (getComputedStyle(document.documentElement).getPropertyValue('--matrix-fade')||'rgba(3,3,3,0.05)');
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00FF41';
      ctx.font = '14px Space Mono, monospace';
      for (let i = 0; i < drops.length; i++) {
        const ch = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(ch, i * 16, drops[i] * 16);
        if (drops[i] * 16 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }

    init();
    window.addEventListener('resize', init);
    setInterval(draw, 50);
  })();
</script>
</BaseLayout>
