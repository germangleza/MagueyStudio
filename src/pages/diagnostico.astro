---
// ─────────────────────────────────────────────────────────────
// NÚMERO DE WHATSAPP — cámbialo aquí si quieres una línea
// distinta para eventos. Por defecto usa el número del sitio.
const WHATSAPP_NUMBER = '5215560663926';
// ─────────────────────────────────────────────────────────────

const canonical = 'https://magueystudio.mx/diagnostico';
const title = 'Diagnóstico digital gratis para clínicas y consultorios | Maguey Studio';
const description =
  'Te preparo un diagnóstico gratuito de tu presencia digital: qué encuentra un paciente cuando te busca en Google y qué recomienda la IA cuando preguntan por alguien como tú.';

// Mensaje base (sin evento). El script inline lo ajusta según ?e=
const baseMessage = 'Hola, quiero mi diagnóstico digital gratis. Vengo de un evento.';
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(baseMessage)}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Diagnóstico digital gratuito para clínicas y consultorios',
  serviceType: 'Diagnóstico de presencia digital',
  description,
  url: canonical,
  areaServed: 'MX',
  provider: {
    '@type': 'Organization',
    name: 'Maguey Studio',
    alternateName: 'Maguey Studio®',
    url: 'https://magueystudio.mx',
    logo: 'https://magueystudio.mx/logo.png',
    telephone: '+525560663926',
    sameAs: ['https://wa.me/5215560663926'],
  },
  audience: {
    '@type': 'BusinessAudience',
    name: 'Clínicas, consultorios y ópticas',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'MXN',
    description: 'Diagnóstico sin costo, entregado en una llamada de 15 minutos.',
  },
};
---

<!doctype html>
<html lang="es-MX">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="#519536">

<meta property="og:type" content="website">
<meta property="og:locale" content="es_MX">
<meta property="og:site_name" content="Maguey Studio">
<meta property="og:title" content="Diagnóstico digital gratis para clínicas y consultorios">
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content="https://magueystudio.mx/logo.png">
<meta name="twitter:card" content="summary">

<link rel="icon" href="/logo.png">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  /* ===== TOKENS MAGUEY ===== */
  :root{
    --verde:#519536;
    --verde-hover:#437c2d;
    --agave:#2F5D46;
    --lima:#9BB558;
    --crema:#FAF7F0;
    --tinta:#1F2A24;
    --tinta-suave:#5A6B60;
    --linea:rgba(47,93,70,.14);
  }

  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

  html{-webkit-text-size-adjust:100%;}

  body{
    background:var(--crema);
    color:var(--tinta);
    font-family:Arial, Helvetica, sans-serif;
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }

  .wrap{
    width:100%;
    max-width:560px;
    margin-inline:auto;
    padding-inline:24px;
  }

  h1,h2,.display{
    font-family:Georgia, 'Times New Roman', serif;
    font-weight:normal;
    line-height:1.15;
    letter-spacing:-.01em;
    color:var(--agave);
  }

  /* ===== HERO — todo visible sin scroll en 375px ===== */
  .hero{
    padding-top:28px;
    padding-bottom:40px;
  }

  .marca{
    display:flex;
    align-items:center;
    gap:9px;
    margin-bottom:28px;
  }
  .marca img{
    width:28px;height:28px;
    display:block;
  }
  .marca span{
    font-family:Georgia, serif;
    font-size:15px;
    color:var(--agave);
    letter-spacing:.01em;
  }

  h1{
    font-size:clamp(28px, 8.2vw, 40px);
    margin-bottom:16px;
    text-wrap:balance;
  }

  .sub{
    font-size:15px;
    color:var(--tinta-suave);
    margin-bottom:26px;
    max-width:44ch;
  }

  /* ===== BOTÓN WHATSAPP ===== */
  .cta{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    width:100%;
    background:var(--verde);
    color:#fff;
    font-family:Arial, Helvetica, sans-serif;
    font-size:17px;
    font-weight:bold;
    text-decoration:none;
    padding:18px 20px;
    border-radius:10px;
    box-shadow:0 2px 0 rgba(47,93,70,.18);
    transition:background .15s ease;
  }
  .cta:active{background:var(--verde-hover);}
  @media (hover:hover){
    .cta:hover{background:var(--verde-hover);}
  }
  .cta svg{flex:none;}

  /* ===== SECCIÓN: QUÉ INCLUYE ===== */
  .incluye{
    padding-block:36px;
    border-top:1px solid var(--linea);
  }

  h2{
    font-size:clamp(21px, 5.6vw, 26px);
    margin-bottom:20px;
  }

  .lista{list-style:none;}
  .lista li{
    position:relative;
    padding-left:26px;
    margin-bottom:15px;
    font-size:15px;
    color:var(--tinta);
  }
  .lista li::before{
    content:"◆";
    position:absolute;
    left:0;
    top:0;
    color:var(--lima);
    font-size:13px;
    line-height:1.7;
  }

  .remate{
    margin-top:22px;
    padding-top:18px;
    border-top:1px solid var(--linea);
    font-size:14px;
    color:var(--tinta-suave);
  }

  /* ===== PRUEBA SOCIAL ===== */
  .prueba{
    padding-block:30px;
    border-top:1px solid var(--linea);
    font-family:Georgia, serif;
    font-size:16px;
    color:var(--agave);
  }

  /* ===== CTA FINAL ===== */
  .cierre{
    padding-block:34px 40px;
    border-top:1px solid var(--linea);
  }
  .cierre .nota{
    margin-top:14px;
    text-align:center;
    font-size:13px;
    color:var(--tinta-suave);
  }

  /* ===== FOOTER ===== */
  footer{
    padding-block:22px 30px;
    border-top:1px solid var(--linea);
    font-size:13px;
    color:var(--tinta-suave);
  }
  footer b{
    font-family:Georgia, serif;
    font-weight:normal;
    color:var(--agave);
  }

  /* ===== DESKTOP (secundario) ===== */
  @media (min-width:720px){
    .wrap{max-width:620px;padding-inline:32px;}
    .hero{padding-top:52px;padding-bottom:52px;}
    .marca{margin-bottom:38px;}
    .sub{font-size:16px;}
    .cta{width:auto;align-self:flex-start;padding-inline:34px;}
    .cta-fila{display:flex;}
    .incluye,.cierre{padding-block:46px;}
    .lista li{font-size:16px;}
  }
</style>
</head>
<body>

<main class="wrap">

  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="marca">
      <img src="/logo.png" alt="" width="28" height="28" fetchpriority="high">
      <span>Maguey Studio</span>
    </div>

    <h1>¿Tu clínica aparece cuando un paciente busca?</h1>

    <p class="sub">
      Te preparo un diagnóstico gratuito de tu presencia digital: qué encuentra un
      paciente cuando te busca en Google y qué recomienda la IA cuando le preguntan
      por alguien como tú.
    </p>

    <div class="cta-fila">
      <a class="cta" id="wa1" href={waHref} target="_blank" rel="noopener">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z"/></svg>
        Quiero mi diagnóstico gratis
      </a>
    </div>
  </section>

  <!-- ══ QUÉ INCLUYE ══ -->
  <section class="incluye">
    <h2>Qué incluye</h2>
    <ul class="lista">
      <li>Cómo aparece tu negocio en Google Maps y qué errores tiene tu ficha</li>
      <li>Si ChatGPT y otras IAs te recomiendan — o recomiendan a tu competencia</li>
      <li>Qué encuentra un paciente en los primeros 10 segundos de buscarte</li>
      <li>Las 3 correcciones de mayor impacto, en orden</li>
    </ul>
    <p class="remate">
      Sin costo, sin compromiso. Te lo entrego en una llamada de 15 minutos.
    </p>
  </section>

  <!-- ══ PRUEBA SOCIAL ══ -->
  <section class="prueba">
    Trabajamos con clínicas, consultorios y ópticas en CDMX, Tijuana y Chiapas.
  </section>

  <!-- ══ CTA FINAL ══ -->
  <section class="cierre">
    <div class="cta-fila">
      <a class="cta" id="wa2" href={waHref} target="_blank" rel="noopener">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z"/></svg>
        Quiero mi diagnóstico gratis
      </a>
    </div>
    <p class="nota">Respondo el mismo día.</p>
  </section>

  <!-- ══ FOOTER ══ -->
  <footer>
    <b>Maguey Studio</b> · magueystudio.mx
  </footer>

</main>

<script is:inline define:vars={{ WHATSAPP_NUMBER }}>
  // Personaliza el mensaje de WhatsApp según el QR escaneado (?e=)
  (function () {
    var eventos = {
      expomed: 'Expo Med',
      optica: 'Summit Vision y Óptica',
      claude: 'Claude for Healthcare'
    };
    var e = new URLSearchParams(location.search).get('e');
    var evento = (e && eventos[e.toLowerCase()]) || 'un evento';
    var href = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' +
      encodeURIComponent('Hola, quiero mi diagnóstico digital gratis. Vengo de ' + evento + '.');
    var a1 = document.getElementById('wa1');
    var a2 = document.getElementById('wa2');
    if (a1) a1.href = href;
    if (a2) a2.href = href;
  })();
</script>

</body>
</html>
