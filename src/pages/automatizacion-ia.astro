---
import BaseLayout from '../layouts/BaseLayout.astro';

const waHref = 'https://wa.me/5215560663926?text=Hola%2C%20quiero%20automatizar%20mi%20negocio%20con%20IA.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F';

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Automatización & IA",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Maguey Studio",
    "url": "https://magueystudio.mx/",
    "telephone": "+525560663926"
  },
  "description": "Automatizaciones, dashboards y agentes de IA que atienden por WhatsApp 24/7, dan seguimiento a leads y conectan las herramientas de tu negocio para vender y operar mejor sin contratar más personal.",
  "url": "https://magueystudio.mx/automatizacion-ia",
  "areaServed": {"@type": "Country", "name": "México"}
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Un agente de IA puede realmente atender a mis clientes por WhatsApp?",
      "acceptedAnswer": {"@type": "Answer", "text": "Sí. Entrenamos el agente con la información de tu negocio — servicios, precios, horarios, políticas — para que responda al instante, 24/7, con el tono de tu marca. Y cuando la conversación necesita a un humano, la transfiere a tu equipo con todo el contexto."}
    },
    {
      "@type": "Question",
      "name": "¿Necesito ser una empresa grande o tener conocimientos técnicos?",
      "acceptedAnswer": {"@type": "Answer", "text": "No. Diseñamos automatizaciones para negocios locales y pymes. Nosotros nos encargamos de toda la parte técnica; tú solo ves los resultados: clientes atendidos, leads con seguimiento y reportes claros."}
    },
    {
      "@type": "Question",
      "name": "¿Qué procesos de mi negocio se pueden automatizar?",
      "acceptedAnswer": {"@type": "Answer", "text": "Los más comunes: atención inicial por WhatsApp, agendado de citas, seguimiento de leads que no compraron, recordatorios, captura de datos de formularios hacia tu CRM u hojas de cálculo, y reportes automáticos de ventas y operación."}
    },
    {
      "@type": "Question",
      "name": "¿La IA va a reemplazar a mi equipo?",
      "acceptedAnswer": {"@type": "Answer", "text": "No — lo va a liberar. La IA se encarga de lo repetitivo: responder lo mismo 50 veces al día, perseguir leads, llenar hojas de cálculo. Tu equipo se enfoca en cerrar ventas y atender bien a los clientes que ya están listos."}
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo toma implementar una automatización?",
      "acceptedAnswer": {"@type": "Answer", "text": "Depende del alcance, pero un agente de WhatsApp o un flujo de seguimiento típico queda funcionando en 2 a 4 semanas. Empezamos con lo que genera impacto más rápido y crecemos desde ahí."}
    },
    {
      "@type": "Question",
      "name": "¿Cómo sé si me conviene invertir en automatización?",
      "acceptedAnswer": {"@type": "Answer", "text": "Hazte una pregunta: ¿cuántos clientes pierdes por responder tarde o por no dar seguimiento? Si la respuesta es 'no sé' o 'varios', la automatización se paga sola. En el diagnóstico gratuito te mostramos exactamente dónde estás dejando dinero sobre la mesa."}
    }
  ]
};

const nav = {
  links: [
    { href: '#casos', label: 'Casos de uso' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#faq', label: 'Preguntas' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/', label: 'Inicio' },
  ],
  mobileLinks: [
    { href: '#casos', label: 'Casos de uso' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#faq', label: 'Preguntas' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/', label: 'Inicio' },
  ],
  ctaHref: waHref,
  ctaLabel: 'Solicitar Diagnóstico',
  ctaAria: 'Solicitar diagnóstico de automatización por WhatsApp',
};

const footer = {
  links: [
    { href: '/', label: 'Inicio' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/#proceso', label: 'Proceso' },
    { href: 'https://wa.me/5215560663926', label: 'WhatsApp', aria: 'Contactar por WhatsApp' },
  ],
};

const wa = {
  href: waHref,
  aria: 'Escríbenos por WhatsApp sobre Automatización e IA',
};
---
<BaseLayout
  title="Automatización & IA para tu Negocio | Maguey Studio®"
  description="Agentes de IA que atienden por WhatsApp 24/7, seguimiento automático de leads, dashboards y flujos que conectan tus herramientas. Vende y opera más sin contratar más personal. Diagnóstico gratuito."
  canonical="https://magueystudio.mx/automatizacion-ia"
  ogType="website"
  ogTitle="Automatización & IA para tu Negocio | Maguey Studio®"
  ogDescription="Agentes de IA que atienden por WhatsApp 24/7, seguimiento automático de leads y dashboards para operar mejor sin contratar más personal."
  twitterTitle="Automatización & IA para tu Negocio | Maguey Studio®"
  twitterDescription="Agentes de IA que atienden por WhatsApp 24/7, seguimiento automático de leads y dashboards para operar mejor sin contratar más personal."
  nav={nav}
  footer={footer}
  wa={wa}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />

<main id="main-content">

<!-- HERO -->
<section class="hero" aria-label="Automatización e inteligencia artificial para tu negocio">
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>

  <div class="hero-tag" style="position:relative;z-index:1;">Automatización &amp; IA</div>

  <h1 class="hero-title" style="position:relative;z-index:1;">
    TU NEGOCIO ATENDIENDO<br>
    <em class="glitch" data-text="24/7">24/7</em><br>
    <span class="outline">SIN CONTRATAR MÁS PERSONAL</span>
  </h1>

  <div class="hero-content" style="position:relative;z-index:1;">
    <div class="hero-bottom">
      <p class="hero-desc">
        Automatizaciones, dashboards y agentes de IA que responden por WhatsApp al instante, dan seguimiento a cada lead y operan tu negocio mientras tú te enfocas en crecer.
      </p>
      <div class="hero-actions">
        <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20automatizar%20mi%20negocio%20con%20IA.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
        <a href="#casos" class="btn-ghost">Ver casos de uso</a>
      </div>
    </div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-inner">
    <span class="ticker-item">Agentes de IA</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">WhatsApp 24/7</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Seguimiento Automático</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Dashboards</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Flujos Conectados</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Cero Leads Perdidos</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Agentes de IA</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">WhatsApp 24/7</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Seguimiento Automático</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Dashboards</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Flujos Conectados</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Cero Leads Perdidos</span><span class="ticker-sep">✦</span>
  </div>
</div>

<!-- PROBLEMA -->
<section class="problem-section" aria-label="El problema de operar todo manualmente">
  <div class="section-label reveal" style="justify-content:center;">El problema</div>
  <h2 class="problem-title reveal">
    CADA MENSAJE SIN RESPONDER<br>
    <em style="font-style:normal; color:var(--green);">ES UN CLIENTE QUE SE VA CON TU COMPETENCIA.</em>
  </h2>
  <p class="problem-desc reveal">
    Responder tarde, olvidar dar seguimiento, capturar datos a mano, no saber cuánto vendes hasta fin de mes. Todo eso te cuesta ventas todos los días — y contratar más gente no siempre es la solución.
  </p>
</section>

<!-- CASOS DE USO -->
<section id="casos" aria-label="Casos de uso de automatización e IA">
  <div class="section-label reveal">Lo que construimos</div>
  <h2 class="features-title reveal">IA QUE TRABAJA<br>PARA TU <em>NEGOCIO</em></h2>

  <div class="features-grid">
    <div class="feature-card reveal">
      <span class="feature-icon">⟡</span>
      <h3 class="feature-name">Agente de WhatsApp 24/7</h3>
      <p class="feature-desc">Un agente de IA entrenado con tu negocio que responde al instante, resuelve dudas, cotiza y agenda citas — a las 3 de la tarde o a las 3 de la mañana.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">◈</span>
      <h3 class="feature-name">Seguimiento Automático de Leads</h3>
      <p class="feature-desc">Nadie se queda sin respuesta. Cada prospecto recibe seguimiento puntual y personalizado hasta que compra o te dice que no. Sin depender de la memoria de nadie.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">◉</span>
      <h3 class="feature-name">Dashboards de Negocio</h3>
      <p class="feature-desc">Ventas, leads, citas y operación en un solo tablero, en tiempo real. Deja de decidir a ciegas y empieza a decidir con datos.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⬡</span>
      <h3 class="feature-name">Flujos que Conectan Todo</h3>
      <p class="feature-desc">Formularios, CRM, hojas de cálculo, WhatsApp y correo hablando entre sí. La información fluye sola — sin capturas manuales ni errores.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">⚡</span>
      <h3 class="feature-name">Respuesta en Segundos</h3>
      <p class="feature-desc">El 78% de los clientes compra al primero que responde. Con automatización, ese primero siempre eres tú.</p>
    </div>
    <div class="feature-card reveal">
      <span class="feature-icon">✦</span>
      <h3 class="feature-name">Preparado para GEO</h3>
      <p class="feature-desc">Tus sistemas y tu presencia digital se apoyan en <a href="/geo">GEO</a>: optimización para que ChatGPT, Gemini y otros motores de IA recomienden tu negocio.</p>
    </div>
  </div>

  <div class="section-cta reveal">
    <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20automatizar%20mi%20negocio%20con%20IA.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
  </div>
</section>

<!-- PROCESO -->
<section class="process" id="proceso" aria-label="Proceso de implementación de automatización e IA">
  <div class="process-grid-bg"></div>
  <div style="position:relative;">
    <div class="section-label reveal">Proceso</div>
    <h2 class="process-title reveal">ASÍ AUTOMATIZAMOS<br>TU <em>OPERACIÓN</em></h2>

    <div class="steps">
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">01</div>
        <h3 class="step-title">Diagnóstico</h3>
        <p class="step-desc">Mapeamos tu operación y detectamos dónde pierdes tiempo, leads y dinero.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">02</div>
        <h3 class="step-title">Diseño del Sistema</h3>
        <p class="step-desc">Definimos qué automatizar primero: lo que genera impacto más rápido en tus ventas.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">03</div>
        <h3 class="step-title">Implementación</h3>
        <p class="step-desc">Construimos y entrenamos tus agentes, flujos y dashboards con la información real de tu negocio.</p>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">04</div>
        <h3 class="step-title">Optimización Continua</h3>
        <p class="step-desc">Medimos cada conversación y cada flujo. Lo que funciona se escala; lo que no, se ajusta.</p>
      </div>
    </div>

    <div class="section-cta reveal">
      <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20automatizar%20mi%20negocio%20con%20IA.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
    </div>
  </div>
</section>

<!-- PARA QUIÉN -->
<section id="para-quien" aria-label="Para qué tipo de negocio es ideal la automatización">
  <div class="section-label reveal">Ideal para</div>
  <h2 class="forwho-title reveal">¿ES PARA<br>TU <em>NEGOCIO</em>?</h2>

  <div class="forwho-grid">
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Negocios que reciben muchos mensajes por WhatsApp</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Clínicas y consultorios que agendan citas todo el día</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Equipos de ventas que pierden leads por falta de seguimiento</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Restaurantes, hoteles y servicios con reservaciones</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Empresas que capturan datos a mano entre sistemas</span>
    </div>
    <div class="forwho-item reveal">
      <div class="forwho-dot"></div>
      <span>Dueños que quieren ver su negocio en números, no en corazonadas</span>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="faq-section" id="faq" aria-label="Preguntas frecuentes sobre automatización e IA">
  <div class="section-label reveal">Preguntas frecuentes</div>
  <h2 class="faq-title reveal">LO QUE TODOS<br>NOS <em>PREGUNTAN</em></h2>

  <div class="faq-list">
    <details class="faq-item reveal">
      <summary>¿Un agente de IA puede realmente atender a mis clientes por WhatsApp?</summary>
      <p class="faq-answer">Sí. Entrenamos el agente con la información de tu negocio — servicios, precios, horarios, políticas — para que responda al instante, 24/7, con el tono de tu marca. Y cuando la conversación necesita a un humano, la transfiere a tu equipo con todo el contexto.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Necesito ser una empresa grande o tener conocimientos técnicos?</summary>
      <p class="faq-answer">No. Diseñamos automatizaciones para negocios locales y pymes. Nosotros nos encargamos de toda la parte técnica; tú solo ves los resultados: clientes atendidos, leads con seguimiento y reportes claros.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Qué procesos de mi negocio se pueden automatizar?</summary>
      <p class="faq-answer">Los más comunes: atención inicial por WhatsApp, agendado de citas, seguimiento de leads que no compraron, recordatorios, captura de datos de formularios hacia tu CRM u hojas de cálculo, y reportes automáticos de ventas y operación.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿La IA va a reemplazar a mi equipo?</summary>
      <p class="faq-answer">No — lo va a liberar. La IA se encarga de lo repetitivo: responder lo mismo 50 veces al día, perseguir leads, llenar hojas de cálculo. Tu equipo se enfoca en cerrar ventas y atender bien a los clientes que ya están listos.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Cuánto tiempo toma implementar una automatización?</summary>
      <p class="faq-answer">Depende del alcance, pero un agente de WhatsApp o un flujo de seguimiento típico queda funcionando en 2 a 4 semanas. Empezamos con lo que genera impacto más rápido y crecemos desde ahí.</p>
    </details>
    <details class="faq-item reveal">
      <summary>¿Cómo sé si me conviene invertir en automatización?</summary>
      <p class="faq-answer">Hazte una pregunta: ¿cuántos clientes pierdes por responder tarde o por no dar seguimiento? Si la respuesta es "no sé" o "varios", la automatización se paga sola. En el diagnóstico gratuito te mostramos exactamente dónde estás dejando dinero sobre la mesa.</p>
    </details>
  </div>
</section>

<!-- CTA FINAL -->
<section class="cta-section" aria-label="Solicitar diagnóstico gratuito de automatización">
  <div class="cta-grid-bg"></div>
  <div class="cta-eyebrow reveal">Sin compromiso. Sin costo.</div>
  <h2 class="cta-title reveal">TU NEGOCIO<br><span class="glitch-word" data-text="OPERANDO">OPERANDO</span><br>EN AUTOMÁTICO</h2>
  <div style="position:relative;z-index:1;">
    <a href="https://wa.me/5215560663926?text=Hola%2C%20quiero%20automatizar%20mi%20negocio%20con%20IA.%20%C2%BFMe%20dan%20m%C3%A1s%20informaci%C3%B3n%3F" class="btn-primary">Solicitar Diagnóstico Gratuito</a>
    <p class="cta-sub">Te decimos exactamente qué automatizar y cuánto te está costando no hacerlo.</p>
  </div>
</section>

</main>
</BaseLayout>

<style is:global>
  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 140px 5% 80px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,255,65,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,65,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridshift 20s linear infinite;
  }
  @keyframes gridshift {
    0% { transform: translate(0,0); }
    100% { transform: translate(60px,60px); }
  }
  .hero-glow {
    position: absolute;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(0,255,65,0.08) 0%, transparent 70%);
    top: 10%; right: -100px;
    border-radius: 50%;
    animation: pulse 4s ease-in-out infinite alternate;
  }
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.2); opacity: 1; }
  }
  .hero-tag {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--green);
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    animation: fadeUp 1s ease both;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(64px, 8vw, 120px);
    line-height: 0.92;
    letter-spacing: -1px;
    margin-bottom: 0;
    max-width: 80%;
    animation: slideFromLeft 1s 0.1s ease both;
  }
  @keyframes slideFromLeft {
    from { opacity: 0; transform: translateX(-60px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .hero-title em { font-style: normal; color: var(--green); }
  .hero-title .outline {
    -webkit-text-stroke: 1px var(--white);
    color: transparent;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    width: 100%;
    animation: fadeUp 1s 0.15s ease both;
    margin-top: 48px;
  }
  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    max-width: 540px;
  }
  .hero-desc {
    font-size: 18px;
    line-height: 1.7;
    color: var(--white);
    font-weight: 300;
    text-align: center;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* TICKER */
  .ticker {
    background: var(--green);
    padding: 14px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .ticker-inner { display: inline-flex; animation: ticker 20s linear infinite; }
  .ticker-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--black);
    padding: 0 40px;
  }
  .ticker-sep { font-size: 18px; color: rgba(0,0,0,0.3); padding: 0 10px; }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* PROBLEM SECTION */
  .problem-section {
    background: var(--dark);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .problem-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.1;
    margin-bottom: 32px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }
  .problem-desc {
    font-size: 18px;
    line-height: 1.8;
    color: var(--white);
    font-weight: 300;
    max-width: 560px;
    margin: 0 auto;
  }

  /* FEATURES GRID */
  .features-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 7vw, 100px);
    line-height: 0.95;
    margin-bottom: 80px;
    max-width: 700px;
  }
  .features-title em { font-style: normal; color: var(--green); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .feature-card {
    background: var(--dark);
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
  }
  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,255,65,0.04) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .feature-card:hover { background: var(--dark); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon {
    font-size: 32px;
