---
import BaseLayout from '../layouts/BaseLayout.astro';

const waMain = 'https://wa.me/5215560663926?text=Hola%2C%20tengo%20una%20cl%C3%ADnica%2Fconsultorio%20y%20quiero%20un%20diagn%C3%B3stico%20gratuito%20de%20mi%20marketing%20digital.';
const nav = {
  links: [
    { href: '#servicios', label: 'Servicios' },
    { href: '#proceso', label: 'Cómo lo hacemos' },
    { href: '#faq', label: 'Preguntas' },
    { href: '/', label: 'Inicio' },
  ],
  mobileLinks: [
    { href: '#servicios', label: 'Servicios' },
    { href: '#proceso', label: 'Cómo lo hacemos' },
    { href: '#faq', label: 'Preguntas' },
    { href: '/', label: 'Inicio' },
  ],
  ctaHref: waMain,
  ctaLabel: 'Diagnóstico Gratis',
  ctaAria: 'Solicitar diagnóstico por WhatsApp',
};
const footer = {
  links: [
    { href: '/', label: 'Inicio' },
    { href: '/#servicios', label: 'Servicios' },
    { href: '/geo', label: 'GEO' },
    { href: '/blog', label: 'Blog' },
    { href: 'https://wa.me/5215560663926', label: 'WhatsApp', aria: 'Contactar por WhatsApp' },
  ],
};
const wa = { href: waMain, aria: 'Escribir por WhatsApp' };
---
<BaseLayout
  title="Marketing digital 360 para clínicas, consultorios y spas | Maguey Studio®"
  description="Todo el marketing digital de su clínica en un solo equipo: asesoría COFEPRIS, Google Maps, sitio web, SEO/GEO, redes sociales, agente de WhatsApp que agenda citas 24/7 y campañas de Ads. Diagnóstico gratuito."
  canonical="https://magueystudio.mx/salud"
  ogTitle="Marketing digital 360 para clínicas, consultorios y spas | Maguey Studio®"
  ogDescription="Del registro de publicidad ante COFEPRIS hasta pacientes agendando solos por WhatsApp. Un solo equipo para todo el marketing de su clínica."
  twitterDescription="Del registro ante COFEPRIS hasta pacientes agendando solos por WhatsApp. Un solo equipo para todo el marketing de su clínica."
  nav={nav}
  footer={footer}
  wa={wa}
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Marketing Digital 360 para el Sector Salud",
  "serviceType": "Marketing digital integral para clínicas, consultorios dentales y médicos",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Maguey Studio",
    "url": "https://magueystudio.mx/",
    "telephone": "+525560663926",
    "address": [
      {"@type": "PostalAddress", "addressLocality": "Tuxtla Gutiérrez", "addressRegion": "Chiapas", "addressCountry": "MX"},
      {"@type": "PostalAddress", "addressLocality": "Tijuana", "addressRegion": "Baja California", "addressCountry": "MX"},
      {"@type": "PostalAddress", "addressLocality": "Ciudad de México", "addressCountry": "MX"}
    ]
  },
  "description": "Servicio integral de marketing digital para clínicas y consultorios: asesoría en registro de publicidad ante COFEPRIS, Google Business Profile, sitio web profesional, SEO/GEO, redes sociales, automatización de citas con agentes de IA por WhatsApp y campañas de Google Ads y Meta Ads.",
  "url": "https://magueystudio.mx/salud",
  "areaServed": "MX"
})} />
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question","name": "¿Necesito un permiso de COFEPRIS para anunciar mi consultorio?","acceptedAnswer": {"@type": "Answer","text": "Si va a publicitar servicios de salud en México, la normativa exige contar con un permiso de publicidad sanitaria ante COFEPRIS. Nosotros lo asesoramos y acompañamos durante todo el trámite para que su publicidad cumpla la norma desde el primer día."}},
    {"@type": "Question","name": "¿Pueden llevar todo mi marketing o solo una parte?","acceptedAnswer": {"@type": "Answer","text": "Ambas. Podemos encargarnos del ecosistema completo — desde COFEPRIS hasta las campañas de Ads — o de un solo servicio, como su sitio web o el agente de WhatsApp. El plan se arma según la etapa de su clínica."}},
    {"@type": "Question","name": "¿Trabajan con spas y clínicas de belleza?","acceptedAnswer": {"@type": "Answer","text": "Sí. Además de dentistas, médicos y clínicas, trabajamos con spas, clínicas de belleza y estética, ópticas y cualquier negocio que atienda con cita."}},
    {"@type": "Question","name": "¿Cuánto cuesta el servicio?","acceptedAnswer": {"@type": "Answer","text": "Depende de los servicios que su clínica necesite y de la etapa en la que se encuentre. Por eso el primer paso es un diagnóstico gratuito de 15 minutos por WhatsApp: analizamos su situación y le proponemos un plan con precios claros, sin compromiso."}},
    {"@type": "Question","name": "¿En cuánto tiempo veo resultados?","acceptedAnswer": {"@type": "Answer","text": "Las campañas de Ads y el agente de WhatsApp generan citas desde las primeras semanas. El posicionamiento en Google Maps suele mejorar en 1 a 3 meses, y el SEO/GEO es una inversión que crece mes a mes. En el diagnóstico le decimos qué esperar en cada frente."}},
    {"@type": "Question","name": "¿El agente de WhatsApp de verdad agenda citas solo?","acceptedAnswer": {"@type": "Answer","text": "Sí. El agente de IA responde al instante 24/7, resuelve dudas frecuentes, ofrece horarios disponibles, agenda la cita, la confirma y envía recordatorios para reducir inasistencias. Su recepción solo interviene en los casos que requieren atención humana."}},
    {"@type": "Question","name": "¿Trabajan con clínicas fuera de su ciudad?","acceptedAnswer": {"@type": "Answer","text": "Sí. Operamos en Tuxtla Gutiérrez, Tijuana y Ciudad de México, y trabajamos con clínicas y consultorios de todo el país. Todo el proceso puede llevarse de forma remota: videollamadas, WhatsApp y reportes en línea."}},
    {"@type": "Question","name": "¿El contenido de redes cumple con la regulación de publicidad en salud?","acceptedAnswer": {"@type": "Answer","text": "Sí. Todo el contenido que producimos para clínicas y consultorios se elabora considerando los lineamientos de publicidad sanitaria en México, para que su marca crezca sin poner en riesgo su permiso ni su cédula."}}
  ]
})} />

<main id="main-content">

<!-- HERO -->
<section class="hero" aria-label="Marketing digital 360 para clínicas y consultorios">
  <canvas id="matrixCanvas" style="position:absolute;inset:0;width:100%;height:100%;opacity:0.18;pointer-events:none;z-index:0;"></canvas>
  <div class="hero-grid-bg"></div>
  <div class="hero-glow"></div>

  <div class="hero-tag" style="position:relative;z-index:1;">Salud & Belleza — Marketing Digital</div>

  <h1 class="hero-title" style="position:relative;z-index:1;">
    TODO EL MARKETING DE<br>
    SU <em class="glitch" data-text="CLÍNICA">CLÍNICA</em>,<br>
    <span class="outline">EN UN SOLO EQUIPO</span>
  </h1>

  <div class="hero-content" style="position:relative;z-index:1;">
    <div class="hero-bottom">
      <p class="hero-desc">
        Estrategia digital para dentistas, médicos, clínicas y spas diseñada para una sola cosa: <strong style="color:var(--white);">llenar su agenda con pacientes nuevos.</strong>
      </p>
      <div class="hero-actions">
        <a href={waMain} class="btn-primary">Diagnóstico Gratis por WhatsApp</a>
        <a href="#servicios" class="btn-ghost">Ver los 8 servicios</a>
      </div>
    </div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-inner">
    <span class="ticker-item">COFEPRIS</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Branding</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Google Maps</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Sitio Web</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">SEO / GEO</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Redes Sociales</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Agente de WhatsApp</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Google & Meta Ads</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">COFEPRIS</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Branding</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Google Maps</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Sitio Web</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">SEO / GEO</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Redes Sociales</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Agente de WhatsApp</span><span class="ticker-sep">✦</span>
    <span class="ticker-item">Google & Meta Ads</span><span class="ticker-sep">✦</span>
  </div>
</div>

<!-- PROBLEMA -->
<section class="problem-section" aria-label="El problema de contratar proveedores sueltos">
  <div class="section-label reveal" style="justify-content:center;">El problema</div>
  <h2 class="problem-title reveal">
    USTED ESTUDIÓ PARA ATENDER PACIENTES.<br>
    <em style="font-style:normal; color:var(--green);">NO PARA COORDINAR CINCO PROVEEDORES DE MARKETING.</em>
  </h2>
  <p class="problem-desc reveal">
    Nosotros podemos tomar el frente digital completo de su clínica — o resolver lo que más le urge — para que usted se dedique a lo suyo: sus pacientes.
  </p>
</section>

<!-- DEMO CHATGPT -->
<section class="demo-section" id="demo" aria-label="Compruebe si ChatGPT recomienda su clínica">
  <div class="section-label reveal">Haga la prueba ahora mismo</div>
  <h2 class="demo-title reveal">¿QUÉ RESPONDE CHATGPT CUANDO UN PACIENTE PREGUNTA POR <em>SU ESPECIALIDAD?</em></h2>
  <p class="demo-intro reveal">Sus pacientes ya le preguntan a la IA antes de agendar. Elija su especialidad, escriba su ciudad y vea con sus propios ojos a quién recomienda ChatGPT.</p>

  <div class="demo-box reveal">
    <div class="demo-field">
      <label for="demoGiro">Su especialidad</label>
      <select id="demoGiro">
        <option value="dentista">Dentista</option>
        <option value="dentista de implantes">Dentista de implantes</option>
        <option value="ortodoncista">Ortodoncista</option>
        <option value="médico general">Médico general</option>
        <option value="dermatólogo">Dermatólogo</option>
        <option value="clínica de estética">Clínica de estética</option>
        <option value="spa">Spa</option>
        <option value="óptica">Óptica</option>
        <option value="nutriólogo">Nutriólogo</option>
        <option value="psicólogo">Psicólogo</option>
        <option value="__otro">Otro...</option>
      </select>
      <input type="text" id="demoGiroOtro" placeholder="Escriba su especialidad" autocomplete="off" style="display:none;">
    </div>
    <div class="demo-field">
      <label for="demoCiudad">Su ciudad</label>
      <input type="text" id="demoCiudad" placeholder="ej. Tijuana" autocomplete="off">
    </div>
    <p class="demo-preview" id="demoPreview" aria-live="polite">&gt; ¿Cuál es el mejor dentista en [su ciudad]? Recomiéndame tres opciones.</p>
    <button type="button" class="btn-primary" id="demoBtn" style="width:100%; text-align:center;">Ver qué responde ChatGPT</button>
    <p class="demo-note">¿Su clínica no aparece? Eso se corrige. <a href="https://wa.me/5215560663926?text=Hola%2C%20hice%20la%20prueba%20y%20ChatGPT%20no%20recomienda%20mi%20cl%C3%ADnica.%20Quiero%20mi%20diagn%C3%B3stico%20gratuito.">Hablemos</a>.</p>
  </div>
</section>

<!-- 8 SERVICIOS -->
<section id="servicios" aria-label="Los 8 servicios del recorrido completo del paciente">
  <div class="section-label reveal">Servicios — juntos o por separado</div>
  <h2 class="section-title reveal">8 SERVICIOS.<br>USTED ELIGE <em>CUÁLES</em></h2>
  <p class="reveal" style="max-width:640px;color:#999;font-size:16px;line-height:1.7;margin:24px 0 0;">Cada servicio se contrata de forma independiente. Y si quiere el ecosistema completo, los conectamos bajo una sola estrategia con un solo responsable.</p>

  <div class="services-grid">
    <div class="service-card reveal">
      <div class="service-num">01 / 08</div>
      <span class="service-icon">⬢</span>
      <h3 class="service-name">Asesoría COFEPRIS</h3>
      <p class="service-desc">Para publicitar servicios de salud en México necesita cumplir la norma. Lo asesoramos y acompañamos en el trámite del permiso de publicidad sanitaria ante COFEPRIS, para que anuncie su clínica con total tranquilidad.</p>
    </div>
    <div class="service-card reveal">
      <div class="service-num">02 / 08</div>
      <span class="service-icon">❖</span>
      <h3 class="service-name">Branding & Identidad</h3>
      <p class="service-desc">Diseñamos la imagen de su clínica: logotipo, identidad visual, paleta de colores y tipografías. Una marca profesional y consistente que transmite confianza en su sitio, sus redes y su consultorio.</p>
      <a class="service-link" href="/branding">Ver servicio →</a>
    </div>
    <div class="service-card reveal">
      <div class="service-num">03 / 08</div>
      <span class="service-icon">◎</span>
      <h3 class="service-name">Google Business / Maps</h3>
      <p class="service-desc">Registramos y optimizamos su Google Business Profile para que su consultorio aparezca en el mapa cuando alguien busca "dentista cerca de mí": con reseñas, fotos profesionales y horarios correctos.</p>
      <a class="service-link" href="/google-business">Ver servicio →</a>
    </div>
    <div class="service-card reveal">
      <div class="service-num">04 / 08</div>
      <span class="service-icon">⬡</span>
      <h3 class="service-name">Sitio Web Profesional</h3>
      <p class="service-desc">Un sitio rápido y confiable que convierte visitas en citas: sus servicios, su equipo médico y un botón de WhatsApp siempre a la mano del paciente.</p>
      <a class="service-link" href="/paginas-web">Ver servicio →</a>
    </div>
    <div class="service-card reveal">
      <div class="service-num">05 / 08</div>
      <span class="service-icon">◉</span>
      <h3 class="service-name">Estrategia SEO / GEO</h3>
      <p class="service-desc">Que su clínica aparezca en Google y también en las recomendaciones de ChatGPT y Gemini cuando un paciente pregunta por un especialista en su ciudad.</p>
      <a class="service-link" href="/geo">Ver servicio →</a>
    </div>
    <div class="service-card reveal">
      <div class="service-num">06 / 08</div>
      <span class="service-icon">✦</span>
      <h3 class="service-name">Redes & Contenido</h3>
      <p class="service-desc">Contenido médico que genera confianza y educa a sus pacientes — siempre elaborado cumpliendo los lineamientos de publicidad en salud.</p>
      <a class="service-link" href="/contenido-redes">Ver servicio →</a>
    </div>
    <div class="service-card reveal">
      <div class="service-num">07 / 08</div>
      <span class="service-icon">⟡</span>
      <h3 class="service-name">Agente de IA en WhatsApp</h3>
      <p class="service-desc">Un agente que agenda citas solo, 24/7: responde al instante, ofrece horarios, confirma y envía recordatorios que reducen inasistencias. Su recepción, sin saturarse.</p>
      <a class="service-link" href="/automatizacion-ia">Ver servicio →</a>
    </div>
    <div class="service-card reveal">
      <div class="service-num">08 / 08</div>
      <span class="service-icon">◈</span>
      <h3 class="service-name">Campañas de Ads</h3>
      <p class="service-desc">Google Ads y Meta Ads enfocados en llenar su agenda: llevamos a los pacientes correctos directo a su WhatsApp, con el menor gasto posible.</p>
      <a class="service-link" href="/publicidad-digital">Ver servicio →</a>
    </div>
  </div>

  <div class="section-cta reveal">
    <a href={waMain} class="btn-primary">Diagnóstico Gratis por WhatsApp</a>
  </div>
</section>

<!-- CÓMO LO HACEMOS -->
<section class="process" id="proceso" aria-label="Cómo lo hacemos: plan integral por fases">
  <div class="process-grid-bg"></div>
  <div style="position:relative;">
    <div class="section-label reveal">Cómo lo hacemos</div>
    <h2 class="section-title reveal">EMPIECE DONDE<br>SU CLÍNICA LO <em>NECESITA</em></h2>
    <p class="reveal" style="max-width:640px;color:#999;font-size:16px;line-height:1.7;margin:24px 0 0;">Este es el camino que recomendamos cuando nos toca construir desde cero. Pero puede entrar en cualquier fase: si ya tiene sitio, arrancamos con visibilidad; si ya lo encuentran, automatizamos su agenda.</p>

    <div class="steps">
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">FASE 01</div>
        <h3 class="step-title">Fundación Legal y Presencia</h3>
        <div class="step-desc">
          Lo primero es que pueda anunciarse cumpliendo la norma y que los pacientes lo encuentren.
          <ul>
            <li>Asesoría y trámite ante COFEPRIS</li>
            <li>Google Business Profile optimizado</li>
            <li>Sitio web profesional</li>
          </ul>
        </div>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">FASE 02</div>
        <h3 class="step-title">Visibilidad</h3>
        <div class="step-desc">
          Que su clínica aparezca donde los pacientes buscan — y donde preguntan.
          <ul>
            <li>SEO local y GEO (ChatGPT, Gemini)</li>
            <li>Contenido médico que genera confianza</li>
            <li>Reseñas y reputación en línea</li>
          </ul>
        </div>
      </div>
      <div class="step reveal">
        <div class="step-dot"></div>
        <div class="step-num">FASE 03</div>
        <h3 class="step-title">Crecimiento</h3>
        <div class="step-desc">
          Con la base lista, aceleramos y automatizamos la agenda.
          <ul>
            <li>Campañas de Google Ads y Meta Ads</li>
            <li>Agente de WhatsApp que agenda 24/7</li>
            <li>Recordatorios que reducen inasistencias</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="section-cta reveal">
      <a href={waMain} class="btn-primary">Empezar con un Diagnóstico Gratis</a>
    </div>
  </div>
</section>


<!-- PARA QUIÉN ES -->
<section aria-label="Para quién es este servicio">
  <div class="section-label reveal">¿Para quién es?</div>
  <h2 class="section-title reveal">SI ATIENDE PACIENTES O CLIENTES<br>DE <em>SALUD Y BELLEZA</em>, ES PARA USTED</h2>

  <div class="quien-grid">
    <div class="quien-item reveal"><span>🦷</span>Dentistas y clínicas dentales</div>
    <div class="quien-item reveal"><span>🩺</span>Médicos generales y especialistas</div>
    <div class="quien-item reveal"><span>🏥</span>Clínicas y consultorios</div>
    <div class="quien-item reveal"><span>💆</span>Spas y centros de bienestar</div>
    <div class="quien-item reveal"><span>✨</span>Clínicas de belleza y estética</div>
    <div class="quien-item reveal"><span>👁️</span>Ópticas y salud visual</div>
    <div class="quien-item reveal"><span>🥗</span>Nutriólogos y psicólogos</div>
    <div class="quien-item reveal"><span>🔬</span>Laboratorios y estudios clínicos</div>
  </div>
</section>

<!-- PRUEBA SOCIAL -->
<section aria-label="Clínicas y negocios de salud que confían en Maguey Studio">
  <div class="section-label reveal">Confían en nosotros</div>
  <h2 class="section-title reveal">YA LO HACEMOS PARA<br>NEGOCIOS DE <em>SALUD Y BELLEZA</em></h2>

  <div class="proof-grid">
    <div class="proof-card reveal">
      <div class="proof-tag">Consultorio Dental</div>
      <h3 class="proof-name">Santos Consultorio Dental</h3>
      <p class="proof-desc">Acompañamos su presencia digital para que más pacientes encuentren el consultorio y agenden su cita sin fricción.</p>
    </div>
    <div class="proof-card reveal">
      <div class="proof-tag">Alergología</div>
      <h3 class="proof-name">Alergia Balance Center</h3>
      <p class="proof-desc">Presencia digital construida desde cero: identidad, sitio y estrategia para que los pacientes encuentren la clínica y agenden su cita.</p>
    </div>
    <div class="proof-card reveal">
      <div class="proof-tag">Salud Visual</div>
      <h3 class="proof-name">Ópticas Jarmar</h3>
      <p class="proof-desc">Cliente 360°: llevamos todo su ecosistema digital de forma continua — agente de IA en WhatsApp, campañas de Ads, contenido para redes, sitio web y SEO/GEO. Un solo equipo, todos los frentes.</p>
    </div>
    <div class="proof-card reveal">
      <div class="proof-tag">Óptica y Contactología</div>
      <h3 class="proof-name">Clínica Óptica Contactología Especializada</h3>
      <p class="proof-desc">Branding y presencia digital desde cero: identidad de marca y estrategia para que más pacientes encuentren la clínica y agenden su valoración visual sin fricción.</p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="faq-section" id="faq" aria-label="Preguntas frecuentes">
  <div class="section-label reveal">Preguntas frecuentes</div>
  <h2 class="section-title reveal">LO QUE LOS DOCTORES<br>NOS <em>PREGUNTAN</em></h2>

  <div class="faq-list">
    <div class="faq-item reveal">
      <button class="faq-q" aria-expanded="false">¿Necesito un permiso de COFEPRIS para anunciar mi consultorio?</button>
      <div class="faq-a"><p>Si va a publicitar servicios de salud en México, la normativa exige contar con un permiso de publicidad sanitaria ante COFEPRIS. Nosotros lo asesoramos y acompañamos durante todo el trámite, para que su publicidad cumpla la norma desde el primer día y no ponga en riesgo su práctica.</p></div>
    </div>
    <div class="faq-item reveal">
      <button class="faq-q" aria-expanded="false">¿Pueden llevar todo mi marketing o solo una parte?</button>
      <div class="faq-a"><p>Ambas. Podemos encargarnos del ecosistema completo — desde COFEPRIS hasta las campañas de Ads — o de un solo servicio, como su <a href="/paginas-web">sitio web</a> o el <a href="/automatizacion-ia">agente de WhatsApp</a>. El plan se arma según la etapa en la que esté su clínica.</p></div>
    </div>
    <div class="faq-item reveal">
      <button class="faq-q" aria-expanded="false">¿Trabajan con spas y clínicas de belleza?</button>
      <div class="faq-a"><p>Sí. Además de dentistas, médicos y clínicas, trabajamos con spas, clínicas de belleza y estética, ópticas y en general cualquier negocio que atienda pacientes o clientes con cita. La lógica es la misma: que lo encuentren, que confíen y que agenden solos.</p></div>
    </div>
    <div class="faq-item reveal">
      <button class="faq-q" aria-expanded="false">¿Cuánto cuesta el servicio?</button>
