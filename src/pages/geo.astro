<script is:inline>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // MATRIX RAIN
  (function() {
    if (reducedMotion) return;
    const canvas = document.getElementById('matrixCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ01アBCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
    let cols, drops;
    function init() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      cols  = Math.floor(canvas.width / 16);
      drops = Array(cols).fill(1);
    }
    function draw() {
      ctx.fillStyle = (getComputedStyle(document.documentElement).getPropertyValue('--matrix-fade')||'rgba(3,3,3,0.05)');
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00FF41';
      ctx.font = '14px Space Mono, monospace';
      for (let i = 0; i < drops.length; i++) {
        const ch = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(ch, i * 16, drops[i] * 16);
        if (drops[i] * 16 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }
    init();
    window.addEventListener('resize', init);
    setInterval(draw, 50);
  })();

  // FAQ ACCORDION
  document.querySelectorAll('.faq-item').forEach(item => {
    const btn = item.querySelector('.faq-q');
    const ans = item.querySelector('.faq-a');
    btn.addEventListener('click', () => {
      const isOpen = item.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen);
      ans.style.maxHeight = isOpen ? ans.scrollHeight + 'px' : '0';
    });
  });

  // DEMO CHATGPT
  (function() {
    const giro = document.getElementById('demoGiro');
    const ciudad = document.getElementById('demoCiudad');
    const preview = document.getElementById('demoPreview');
    const btn = document.getElementById('demoBtn');
    function buildQuestion() {
      const g = giro.value.trim() || '[tu giro]';
      const c = ciudad.value.trim() || '[tu ciudad]';
      return '¿Cuál es el mejor ' + g + ' en ' + c + '? Recomiéndame tres opciones.';
    }
    function updatePreview() { preview.textContent = '> ' + buildQuestion(); }
    giro.addEventListener('input', updatePreview);
    ciudad.addEventListener('input', updatePreview);
    btn.addEventListener('click', () => {
      if (!giro.value.trim()) { giro.focus(); return; }
      if (!ciudad.value.trim()) { ciudad.focus(); return; }
      window.open('https://chatgpt.com/?q=' + encodeURIComponent(buildQuestion()), '_blank', 'noopener');
    });
    [giro, ciudad].forEach(input => {
      input.addEventListener('keydown', e => { if (e.key === 'Enter') btn.click(); });
    });
  })();
</script>

