---
export interface NavLink { href: string; label: string; }
interface Props {
  links?: NavLink[];
  mobileLinks?: NavLink[];
  ctaHref?: string;
  ctaLabel?: string;
  ctaAria?: string;
}
const {
  links = [
    { href: '#servicios', label: 'Servicios' },
    { href: '#proceso', label: 'Proceso' },
    { href: '/geo', label: 'GEO' },
    { href: '#nosotros', label: 'Nosotros' },
    { href: '/blog', label: 'Blog' },
  ],
  mobileLinks = [
    { href: '#servicios', label: 'Servicios' },
    { href: '/blog', label: 'Blog' },
    { href: '#proceso', label: 'Proceso' },
    { href: '#geo', label: 'GEO' },
    { href: '#nosotros', label: 'Nosotros' },
  ],
  ctaHref = 'https://wa.me/5215560663926',
  ctaLabel = 'Solicitar Diagnóstico',
  ctaAria = 'Cotizar proyecto por WhatsApp',
} = Astro.props;
---
<header role="banner">
  <nav aria-label="Navegación principal">
    <a href="/" class="nav-logo"><img src="/logo.png" alt="Logo Maguey Studio"> MAGUEY STUDIO<sup style="font-size:10px; margin-left:2px; color: var(--muted);">®</sup></a>
    <ul class="nav-links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <a href={ctaHref} class="nav-cta" aria-label={ctaAria}>{ctaLabel}</a>
    <button id="mgTheme" class="nav-theme" type="button" aria-label="Cambiar tema claro u oscuro" title="Cambiar tema">
  <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
</button>
    <button class="nav-hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Menú de navegación">
  {mobileLinks.map((l) => <a href={l.href} class="mobile-link">{l.label}</a>)}
  <a href={ctaHref} class="mobile-cta" aria-label={ctaAria}>{ctaLabel}</a>
</div>
